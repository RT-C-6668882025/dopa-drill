page{--ink:#1b1d4d;--paper:#fff8ec;--blue:#3b6bff;--pink:#ff7ab6;--yellow:#ffd23f;--mint:#3fdcb0;--violet:#a77bff;background:var(--paper);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-weight:700}.paper{position:fixed;inset:0;background:radial-gradient(circle at 12% 18%,rgba(255,122,182,.16) 0 120rpx,transparent 121rpx),radial-gradient(circle at 88% 78%,rgba(59,107,255,.12) 0 160rpx,transparent 161rpx),linear-gradient(rgba(59,107,255,.11) 2rpx,transparent 2rpx) 0 0/52rpx 52rpx,linear-gradient(90deg,rgba(59,107,255,.11) 2rpx,transparent 2rpx) 0 0/52rpx 52rpx,var(--paper)}.app{position:relative;width:100%;max-width:920rpx;height:100vh;margin:auto}.screen{position:absolute;inset:0;box-sizing:border-box}.title{height:100%;padding:80rpx 32rpx 48rpx}.corner{position:absolute;right:28rpx;top:24rpx;display:flex;gap:16rpx}.icon-btn{width:88rpx;height:88rpx;padding:0;border:6rpx solid var(--ink);border-radius:50%;background:#fff;box-shadow:0 8rpx 0 var(--ink);font-weight:900}.help{right:104rpx}.logo{position:relative;text-align:center;margin:80rpx auto 20rpx}.logo-top{display:flex;justify-content:center;gap:4rpx;font-size:150rpx;font-weight:900;line-height:1;color:#fff;text-shadow:6rpx 0 var(--ink),-6rpx 0 var(--ink),0 6rpx var(--ink),0 -6rpx var(--ink),12rpx 14rpx var(--pink)}.logo-top text:nth-child(2){color:#fff;text-shadow:6rpx 0 var(--ink),-6rpx 0 var(--ink),0 6rpx var(--ink),0 -6rpx var(--ink),12rpx 14rpx var(--blue)}.logo-ribbon{display:inline-block;margin-top:6rpx;padding:14rpx 70rpx 20rpx;background:var(--blue);border:7rpx solid var(--ink);border-radius:14rpx;transform:rotate(-3deg);font-size:72rpx;color:#fff;box-shadow:0 10rpx 0 var(--ink)}.logo-bits{position:absolute;inset:0;display:flex;justify-content:space-between;align-items:center;font-size:58rpx;color:var(--mint)}.title-stage,.stage{height:210rpx;display:flex;align-items:flex-end;justify-content:center}.mascot{width:150rpx;height:150rpx;border:7rpx solid var(--ink);border-radius: