page{background:#fff7df;color:#2c251d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.page{height:100vh;box-sizing:border-box;padding:28rpx 28rpx 20rpx;display:flex;flex-direction:column;overflow:hidden}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}
.brand{display:block;font-size:42rpx;font-weight:900;letter-spacing:2rpx}.sub{display:block;font-size:18rpx;opacity:.5;margin-top:4rpx}
.pill{padding:12rpx 20rpx;background:#2c251d;color:#fff;border-radius:999rpx;font-size:22rpx;font-weight:800}
.stage{position:relative;flex:1;min-height:0;border:5rpx solid #2c251d;border-radius:34rpx;background:linear-gradient(180deg,#ffd85a 0%,#ffad49 48%,#ff785a 100%);box-shadow:0 12rpx 0 #2c251d;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center}
.spotlight{position:absolute;top:-80rpx;width:170rpx;height:600rpx;background:rgba(255,255,255,.2);transform:rotate(18deg);filter:blur(3rpx)}.s1{left:70rpx}.s2{right:70rpx;transform:rotate(-18deg)}
.confetti{position:absolute;top:40rpx;width:100%;text-align:center;font-size:34rpx;letter-spacing:12rpx;animation:pop .25s ease-out}
.mascot{position:relative;width:150rpx;height:130rpx;margin-bottom:8rpx;animation:bob 1.1s ease-in-out infinite}
.face{position:absolute;inset:20rpx 12rpx 0;background:#6a3c22;border:5rpx solid #2c251d;border-radius:46% 46% 42% 42%;display:flex;justify-content:space-around;align-items:center;padding:0 28rpx}
.ear{position:absolute;top:40rpx;width:48rpx;height:56rpx;background:#9a5a31;border:5rpx solid #2c251d;border-radius:50%}.ear.left{left:-12rpx}.ear.right{right:-12rpx}
.eye{width:13rpx;height:18rpx;background:#fff;border:4rpx solid #2c251d;border-radius:50%}.mouth{position:absolute;bottom:16rpx;color:#fff;font-size:34rpx;font-weight:900}
.combo{font-size:30rpx;font-weight:1000;color:#fff;text-shadow:0 4rpx 0 #2c251d;transform:rotate(-3deg)}.dopa{font-size:22rpx;font-weight:800;margin:5rpx 0 14rpx}
.problem-card{position:relative;width:82%;box-sizing:border-box;background:#fffdf4;border:5rpx solid #2c251d;border-radius:26rpx;padding:24rpx;text-align:center;box-shadow:0 9rpx 0 rgba(44,37,29,.9)}
.mode{font-size:20rpx;font-weight:800;opacity:.55}.problem{display:flex;justify-content:center;align-items:center;gap:18rpx;font-size:60rpx;font-weight:1000;margin:10rpx 0}.op,.eq{font-size:44rpx}.answer{min-width:90rpx;color:#e45a34}.answer.ok{transform:scale(1.18);color:#1b9b65}.answer.ng{animation:shake .2s linear;color:#d73535}.hint{font-size:21rpx;opacity:.55}
.stats{display:flex;justify-content:space-around;margin:26rpx 0 14rpx}.stats view{text-align:center}.n{display:block;font-size:34rpx;font-weight:1000}.l{display:block;font-size:17rpx;opacity:.45;font-weight:800}
.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.key{height:78rpx;line-height:78rpx;margin:0;padding:0;border-radius:18rpx;background:#fff;border:4rpx solid #2c251d;box-shadow:0 6rpx 0 #2c251d;font-size:32rpx;font-weight:900}.key::after{border:0}.key:active{transform:translateY(5rpx);box-shadow:0 1rpx 0 #2c251d}.utility{background:#f0e6ce}.zero{background:#ffd85a}
.footer{display:flex;gap:12rpx;margin-top:18rpx}.mode-btn{flex:1;height:62rpx;line-height:62rpx;margin:0;padding:0;background:transparent;border:3rpx solid #2c251d;border-radius:999rpx;font-size:21rpx;font-weight:800}.mode-btn::after{border:0}
.celebrating .stage{animation:flash .28s ease-out}.celebrating .mascot{animation:jump .28s ease-out}
@keyframes bob{50%{transform:translateY(-7rpx) rotate(2deg)}}@keyframes jump{50%{transform:translateY(-35rpx) scale(1.12)}}@keyframes pop{from{transform:scale(.5);opacity:0}to{transform:scale(1);opacity:1}}@keyframes shake{25%{transform:translateX(-8rpx)}75%{transform:translateX(8rpx)}}@keyframes flash{50%{filter:brightness(1.15)}}
