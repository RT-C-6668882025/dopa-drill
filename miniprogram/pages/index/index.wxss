page{background:#fff8e6;color:#29241e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.app{min-height:100vh;box-sizing:border-box}.home{padding:34rpx}.hero{margin-top:90rpx;border:5rpx solid #29241e;border-radius:36rpx;padding:50rpx 38rpx;background:#ffd84d;box-shadow:0 12rpx 0 #29241e}.logo,.cn,.tag{display:block}.logo{font-size:64rpx;font-weight:1000;letter-spacing:3rpx}.cn{font-size:34rpx;font-weight:900;margin-top:4rpx}.tag{margin:24rpx 0 40rpx;opacity:.65}.primary{background:#29241e!important;color:white!important;border-radius:999rpx;font-weight:900}.summary{display:flex;justify-content:space-around;margin:54rpx 0 30rpx}.summary view{text-align:center}.summary b,.summary small{display:block}.summary b{font-size:40rpx}.summary small{font-size:20rpx;opacity:.5}.nav{display:flex;gap:12rpx}.nav button{flex:1;font-size:23rpx}.bar,.playtop{height:100rpx;padding:0 24rpx;display:flex;align-items:center;justify-content:space-between;font-weight:900}.bar button,.playtop button{margin:0;width:72rpx;padding:0}.grades{white-space:nowrap;padding:8rpx 20rpx;box-sizing:border-box}.grades button{display:inline-block;margin-right:10rpx;border-radius:999rpx}.on{background:#29241e!important;color:white!important}.skillscroll{height:calc(100vh - 170rpx);padding:18rpx 26rpx;box-sizing:border-box}.skill{background:white;border:4rpx solid #29241e;border-radius:24rpx;margin:16rpx 0;padding:24rpx;display:flex;align-items:center;justify-content:space-between;box-shadow:0 6rpx 0 #29241e}.skill.mastered{background:#e7ffd7}.skill.locked{opacity:.38;box-shadow:none}.lane,.skillname{display:block}.lane{font-size:18rpx;opacity:.45}.skillname{font-size:27rpx;font-weight:900;margin-top:5rpx}.stars{font-size:21rpx;letter-spacing:1rpx}.play{min-height:100vh;background:linear-gradient(#ffd74d,#ff9c50);padding:0 26rpx 24rpx;box-sizing:border-box}.meters{display:flex;justify-content:space-between;font-weight:1000;padding:0 14rpx 18rpx}.paper{background:#fffdf6;border:5rpx solid #29241e;border-radius:28rpx;padding:24rpx 18rpx;box-shadow:0 10rpx 0 #29241e;min-height:470rpx}.ptitle{display:block;text-align:center;font-weight:900;opacity:.5;margin-bottom:20rpx}.grid{display:grid;width:100%;max-width:650rpx;margin:auto;align-items:center;justify-items:center}.cell{font-size:38rpx;font-weight:900;min-width:48rpx;text-align:center}.cell.input{border-bottom:4rpx solid #29241e;min-height:50rpx}.cell.active{background:#ffe568;border-radius:10rpx}.cell.carry,.cell.mark{font-size:22rpx}.cell.hidden{visibility:hidden}.feedback{display:block;text-align:center;margin-top:22rpx;font-weight:900}.feedback.ng{color:#d43c36}.feedback.complete{color:#188b55}.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:28rpx}.keypad button{height:80rpx;border:4rpx solid #29241e;background:white;box-shadow:0 5rpx 0 #29241e;font-size:30rpx;font-weight:900}.keypad .zero{grid-column:2}.result{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26rpx}.big{font-size:54rpx;font-weight:1000}.score{font-size:80rpx;font-weight:1000}.result .primary{width:70%;margin-top:30rpx}.history{background:white;border:3rpx solid #29241e;border-radius:20rpx;padding:22rpx;margin:14rpx 0}.history text,.history b,.history small{display:block}.history b{font-size:30rpx}.history small{opacity:.5}.empty{display:block;text-align:center;margin-top:100rpx;opacity:.5}.settings{padding:30rpx}.settings>button{margin:20rpx 0}.label{display:block;font-weight:900;margin-bottom:15rpx}.choices{display:flex;gap:12rpx}.choices button{flex:1}.danger{margin-top:80rpx!important;color:#c83030!important}
.secondary{margin-top:12rpx}.streak{flex:1;text-align:center;padding:18rpx;font-weight:900}