@font-face { font-family: "Dela Gothic One"; src: url("fonts/dela-gothic-one.woff2") format("woff2"); font-display: block; }
@font-face { font-family: "Zen Maru Gothic"; src: url("fonts/zen-maru-gothic-bold.woff2") format("woff2"); font-weight: 700; font-display: block; }
@font-face { font-family: "Zen Maru Gothic"; src: url("fonts/zen-maru-gothic-black.woff2") format("woff2"); font-weight: 900; font-display: block; }

page {
  --ink: #1b1d4d;
  --paper: #fff8ec;
  --blue: #3b6bff;
  --pink: #ff7ab6;
  --pink-soft: #ffd0e4;
  --blue-soft: #d9e4ff;
  --yellow: #ffd23f;
  --mint: #3fdcb0;
  --violet: #a77bff;
  --red: #ff4f6d;
  --E: 0;
  --kick: 0;
  --round: "Zen Maru Gothic", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  --chunky: "Dela Gothic One", "Zen Maru Gothic", "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
  color-scheme: light;
}

* { box-sizing: border-box; }
html, page { margin: 0; height: 100%; overflow: hidden; }
page {
  background: var(--paper);
  color: var(--ink);
  font-family: var(--round);
  font-weight: 700;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
  user-select: none;
  -webkit-user-select: none;
}
button { font: inherit; color: inherit;  }
button:focus-visible { outline: 8rpx solid var(--yellow); outline-offset: 6rpx; }

#paper {
  position: fixed; inset: 0; z-index: 0;
  background:
    radial-gradient(circle at 12% 18%, rgba(255, 122, 182, .16) 0 240rpx, transparent 242rpx),
    radial-gradient(circle at 88% 78%, rgba(59, 107, 255, .12) 0 320rpx, transparent 322rpx),
    linear-gradient(rgba(59, 107, 255, .11) 3rpx, transparent 3rpx) 0 0 / 52rpx 52rpx,
    linear-gradient(90deg, rgba(59, 107, 255, .11) 3rpx, transparent 3rpx) 0 0 / 52rpx 52rpx,
    var(--paper);
}
#rays-fallback {
  display: none; position: fixed; inset: -50vmax; z-index: 1; opacity: 0; pointer-events: none;
  background: repeating-conic-gradient(from 0deg at 50% 50%, #3b6bff 0 9deg, #ff7ab6 9deg 18deg);
}
#bg { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
#fx-back { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
#fx { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 4; pointer-events: none; }
#actors { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none; overflow: visible; }
#cutins { position: fixed; inset: 0; z-index: 6; pointer-events: none; overflow: hidden; }
#flash { position: fixed; inset: 0; z-index: 7; pointer-events: none; background: #fff; opacity: 0; }
.dk-digit { font-family: var(--round); font-weight: 900; fill: var(--ink); stroke: #fff; stroke-width: 12rpx; paint-order: stroke; }

#app {
  position: relative; z-index: 2;
  width: min(100vw, 920rpx); height: 100dvh; max-height: 1960rpx;
  margin: 0 auto;
}
@media (min-height: 1960rpx) { #app { top: calc((100dvh - 1960rpx) / 2); } }
.screen { position: absolute; inset: 0; display: none; }
.screen.is-active { display: flex; }

/* ------------------------------------------------------------ title */
#screen-title { flex-direction: column; align-items: center; justify-content: flex-start; gap: 28rpx; padding: calc(56rpx + 0rpx) 32rpx calc(48rpx + 0rpx); overflow-y: auto;  }
#screen-title > * { flex: none; }
/* Logo: layered paper cut-outs. A spinning burst sits behind "ドパ",
   "ドリル" rides on a folded ribbon, operator scraps float around. */
.logo { position: relative; margin: calc(var(--fs) * 0.62) 0 calc(var(--fs) * 0.2); display: grid; justify-items: center; font-family: var(--chunky); font-weight: 400; line-height: 1; --fs: clamp(128rpx, 21vw, 192rpx); }
.logo-burst { position: absolute; left: 50%; top: calc(var(--fs) * 0.52); width: calc(var(--fs) * 2.7); height: calc(var(--fs) * 2.7); transform: translate(-50%, -50%) rotate(calc(var(--spin, 0) * 1deg)); z-index: -1; filter: drop-shadow(0 12rpx 0 rgba(27, 29, 77, .9)); }
.logo-top { display: flex; gap: .02em; font-size: var(--fs); letter-spacing: -.04em; }
.logo i { font-style: normal; display: inline-block; position: relative; }
.logo-top i {
  color: #fff;
  /* white paper edge, ink outline, then an offset second sheet */
  text-shadow:
    0 0 0 #fff,
    6rpx 0 0 var(--ink), -6rpx 0 0 var(--ink), 0 6rpx 0 var(--ink), 0 -6rpx 0 var(--ink),
    5rpx 5rpx 0 var(--ink), -5rpx 5rpx 0 var(--ink), 5rpx -5rpx 0 var(--ink), -5rpx -5rpx 0 var(--ink),
    12rpx 14rpx 0 var(--pink), 16rpx 18rpx 0 var(--ink), 8rpx 20rpx 0 var(--ink);
  transform: rotate(var(--r, -6deg)) translateY(var(--dy, 0));
  animation: logo-hop 1.6s cubic-bezier(.3, 1.6, .5, 1) infinite;
}
.logo-top i:nth-child(1) { --r: -9deg; color: #fff; }
.logo-top i:nth-child(2) { --r: 7deg; --dy: -12rpx; animation-delay: -.8s; }
.logo-top i::after { content: attr(data-c); position: absolute; inset: 0; color: var(--blue); clip-path: polygon(0 62%, 100% 50%, 100% 100%, 0 100%); text-shadow: none; }
.logo-top i:nth-child(2)::after { color: var(--pink); }
.logo-ribbon { position: relative; display: flex; justify-content: center; gap: .1em; margin-top: calc(var(--fs) * 0.04); padding: .12em .9em .2em; font-size: calc(var(--fs) * 0.52); color: #fff; transform: rotate(-3deg); }
.ribbon-bg { position: absolute; inset: -6% -14% -10%; width: 128%; height: 116%; z-index: -1; filter: drop-shadow(0 10rpx 0 var(--ink)); }
.logo-ribbon i { text-shadow: 4rpx 0 0 var(--ink), -4rpx 0 0 var(--ink), 0 4rpx 0 var(--ink), 0 -4rpx 0 var(--ink), 0 8rpx 0 var(--ink); animation: logo-wave 1.6s ease-in-out infinite; }
.logo-ribbon i:nth-child(3) { animation-delay: -.25s; }
.logo-ribbon i:nth-child(4) { animation-delay: -.5s; }
.logo-bits { position: absolute; inset: 0; pointer-events: none; }
.logo-bits b { position: absolute; left: calc(50% + var(--x)); top: var(--y); font-size: calc(var(--fs) * 0.4); color: var(--c); transform: translate(-50%, -50%) rotate(var(--r)); text-shadow: 4rpx 0 0 var(--ink), -4rpx 0 0 var(--ink), 0 4rpx 0 var(--ink), 0 -4rpx 0 var(--ink), 6rpx 8rpx 0 var(--ink); animation: logo-float 2.4s ease-in-out infinite; }
.logo-bits b:nth-child(2) { animation-delay: -.6s; }
.logo-bits b:nth-child(3) { animation-delay: -1.2s; }
.logo-bits b:nth-child(4) { animation-delay: -1.8s; }
@keyframes logo-hop { 0%, 100% { transform: rotate(var(--r)) translateY(var(--dy, 0)) scale(1); } 12% { transform: rotate(var(--r)) translateY(calc(var(--dy, 0rpx) + 8rpx)) scale(1.08, .9); } 30% { transform: rotate(calc(var(--r) * -0.4)) translateY(calc(var(--dy, 0rpx) - 20rpx)) scale(.96, 1.06); } 55% { transform: rotate(var(--r)) translateY(var(--dy, 0)) scale(1); } }
@keyframes logo-wave { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
@keyframes logo-float { 0%, 100% { margin-top: 0; } 50% { margin-top: -16rpx; } }
page.reduced .logo *, page.reduced .logo-burst { animation: none !important; }
.settings-btn { display: grid; place-items: center; position: absolute; top: calc(24rpx + 0rpx); right: 28rpx; width: 96rpx; height: 96rpx; padding: 8rpx; background: #fff; box-shadow: 0 8rpx 0 var(--ink); z-index: 3; }
.settings-btn svg { display: block; width: 100%; height: 100%; transition: transform .4s; }
#open-settings:active svg { transform: rotate(90deg); }
.modes { display: flex; flex-direction: column; align-items: center; gap: 20rpx; }

/* ------------------------------------------------------------ settings */
.modal { position: fixed; inset: 0; z-index: 4; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(27, 29, 77, .45); }
.modal[hidden] { display: none; }
.modal-card { width: min(100%, 840rpx); max-height: 100%; overflow: auto; display: flex; flex-direction: column; align-items: stretch; gap: 32rpx; padding: 44rpx 36rpx 40rpx; border: 7rpx solid var(--ink); border-radius: 52rpx; background: var(--paper); box-shadow: 0 16rpx 0 var(--ink); }
.modal-card .chip { align-self: center; margin: 0; font-size: 36rpx; }
.modal-card .big-btn { align-self: center; min-width: 400rpx; height: 116rpx; font-size: 48rpx; }
.set-row { display: flex; flex-direction: column; gap: 16rpx; }
.set-label { font-weight: 900; font-size: 32rpx; }
.set-label b { font-family: var(--chunky); font-weight: 400; color: var(--blue); margin-left: 12rpx; }
.set-inline { display: flex; align-items: center; gap: 24rpx; }
.set-inline .slider { flex: 1; }
.set-note { margin: 0; font-size: 24rpx; opacity: .7; }
.reset-btn { align-self: center; min-width: 460rpx; font-weight: 900; }
.set-credits { margin-top: 8rpx; }
.credits-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border: 5rpx solid var(--ink);
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 8rpx 0 var(--ink);
}
.credits-text {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  font-size: 27rpx;
  line-height: 1.45;
  color: var(--ink);
  font-weight: 800;
}
.credits-heart {
  font-size: 32rpx;
  line-height: 1.2;
  flex-shrink: 0;
}
.credits-desc b {
  color: var(--blue);
  font-family: var(--round);
  font-weight: 900;
}
.credits-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 32rpx;
  border: 5rpx solid var(--ink);
  border-radius: 28rpx;
  background: #f8f9fe;
  color: var(--ink);
  text-decoration: none;
  font-family: var(--round);
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 6rpx 0 var(--ink);
  transition: transform .08s, box-shadow .08s, background .15s;
  
}
.credits-btn:hover {
  background: var(--yellow);
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 0 var(--ink);
}
.credits-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 0 var(--ink);
}
.credits-gh-icon {
  flex-shrink: 0;
}
.credits-arrow {
  font-size: 28rpx;
  font-weight: 900;
  opacity: .75;
}
.modal .pick { justify-content: center; gap: 20rpx; }
.modal .pick button {
  flex: 1;
  max-width: 208rpx;
  height: 112rpx;
  display: inline-flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
  padding: 0 8rpx;
  white-space: nowrap;
}
.lang-pick-group { display: flex; gap: 20rpx; justify-content: center; }
.lang-pick-group button {
  flex: 1;
  max-width: 208rpx;
  height: 112rpx;
  border: 6rpx solid var(--ink);
  border-radius: 32rpx;
  background: #fff;
  font-family: var(--round);
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 0 var(--ink);
  transition: transform .08s;
}
.lang-pick-group button[aria-checked="true"], .lang-pick-group button[aria-pressed="true"] { background: var(--yellow); transform: translateY(-6rpx) rotate(-2deg); }
.lang-pick-group button:active { transform: translateY(10rpx); box-shadow: 0 4rpx 0 var(--ink); }
.slider { -webkit-appearance: none; appearance: none; width: 100%; height: 68rpx; background: transparent; margin: 0; --v: 1; }
.slider::-webkit-slider-runnable-track { height: 28rpx; border: 5rpx solid var(--ink); border-radius: 1998rpx; background: linear-gradient(90deg, var(--pink) 0 calc(var(--v) * 100%), #fff calc(var(--v) * 100%)); }
.slider::-moz-range-track { height: 20rpx; border: 5rpx solid var(--ink); border-radius: 1998rpx; background: linear-gradient(90deg, var(--pink) 0 calc(var(--v) * 100%), #fff calc(var(--v) * 100%)); }
.slider::-webkit-slider-thumb { -webkit-appearance: none; width: 64rpx; height: 64rpx; margin-top: -22rpx; border: 6rpx solid var(--ink); border-radius: 50%; background: var(--yellow); box-shadow: 0 6rpx 0 var(--ink); }
.slider::-moz-range-thumb { width: 52rpx; height: 52rpx; border: 6rpx solid var(--ink); border-radius: 50%; background: var(--yellow); box-shadow: 0 6rpx 0 var(--ink); }
.slider.motion::-webkit-slider-runnable-track { background: linear-gradient(90deg, var(--blue-soft), var(--pink) 50%, var(--yellow)) 0 0 / calc(var(--v) * 100%) 100% no-repeat, #fff; }
.slider.motion::-moz-range-track { background: linear-gradient(90deg, var(--blue-soft), var(--pink) 50%, var(--yellow)) 0 0 / calc(var(--v) * 100%) 100% no-repeat, #fff; }
.title-stage { width: 100%; height: min(26vh, 400rpx); }
.pick { display: flex; gap: 20rpx; }
.pick button {
  width: 168rpx; height: 112rpx; border: 6rpx solid var(--ink); border-radius: 32rpx; background: #fff;
  font-family: var(--chunky); font-size: 50rpx; box-shadow: 0 10rpx 0 var(--ink); transition: transform .08s;
}
.pick button small { font-family: var(--round); font-size: 26rpx; font-weight: 800; margin-left: 2rpx; }
.pick button[aria-checked="true"] { background: var(--yellow); transform: translateY(-6rpx) rotate(-2deg); }
.big-btn {
  min-width: 480rpx; height: 136rpx; padding: 0 56rpx; border: 7rpx solid var(--ink); border-radius: 44rpx;
  background: var(--blue); color: #fff; font-family: var(--chunky); font-size: 56rpx; letter-spacing: .06em;
  box-shadow: 0 14rpx 0 var(--ink); text-shadow: 0 6rpx 0 rgba(27, 29, 77, .55);
}
.big-btn small { font-family: var(--round); font-size: 32rpx; }
.big-btn:active, .sub-btn:active, .pick button:active { transform: translateY(10rpx); box-shadow: 0 4rpx 0 var(--ink); }
.sub-btn { min-width: 320rpx; height: 104rpx; border: 6rpx solid var(--ink); border-radius: 36rpx; background: #fff; font-size: 36rpx; box-shadow: 0 10rpx 0 var(--ink); }
.toggles { display: flex; gap: 20rpx; flex-wrap: wrap; justify-content: center; }
.toggle { display: inline-flex; align-items: center; gap: 12rpx; height: 80rpx; padding: 0 28rpx; border: 5rpx solid var(--ink); border-radius: 1998rpx; background: #fff; font-size: 28rpx; }
.toggle i { font-style: normal; font-size: 32rpx; }
.toggle b { font-weight: 900; color: var(--blue); }
.toggle[aria-pressed="true"][data-toggle="motion"] b { color: var(--pink); }
.hint { margin: 0; font-size: 24rpx; opacity: .6; }

/* ------------------------------------------------------------ play */
#screen-play { flex-direction: column; padding: 16rpx 0 calc(20rpx + 0rpx); }
.hud { display: flex; align-items: center; gap: 20rpx; height: 80rpx; padding: 0 28rpx; }
.pips { display: flex; flex-wrap: wrap; gap: 8rpx; flex: 1; align-items: center; }
.pip { width: 28rpx; height: 28rpx; border-radius: 50%; border: 5rpx solid var(--ink); background: #fff; }
.pips.many .pip { width: 22rpx; height: 22rpx; border-width: 4rpx; }
.pip.now { background: var(--yellow); animation: pip 0.8s ease-in-out infinite; }
.pip.done { background: var(--c, var(--blue)); }
.pip.rainbow { background: conic-gradient(#ff7ab6, #ffd23f, #3fdcb0, #3b6bff, #a77bff, #ff7ab6); }
@keyframes pip { 50% { transform: scale(1.3); } }
.clock { display: flex; align-items: baseline; gap: 16rpx; padding: 8rpx 24rpx; border: 5rpx solid var(--ink); border-radius: 1998rpx; background: #fff; font-size: 24rpx; white-space: nowrap; }
.clock b { font-family: var(--chunky); font-weight: 400; font-size: 36rpx; font-variant-numeric: tabular-nums; }
.clock.over #clock-label { color: var(--red); }
.clock.extra { background: var(--ink); color: #fff; }
.clock.extra b { color: var(--yellow); font-size: 40rpx; }
.clock.hurry b { color: var(--red); animation: hurry .5s steps(2) infinite; }
@keyframes hurry { 50% { color: #fff; } }
.icon-btn { width: 80rpx; height: 80rpx; border-radius: 50%; border: 5rpx solid var(--ink); background: #fff; font-size: 36rpx; flex: none; }
.icon-btn[aria-pressed="true"] { background: var(--ink); color: #fff; text-decoration: line-through; }

.hud2 { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; height: 80rpx; padding: 0 28rpx; }
.tally { display: flex; gap: 12rpx; font-size: 26rpx; }
.tally > span { padding: 6rpx 20rpx; border-radius: 1998rpx; background: #fff; border: 4rpx solid var(--ink); }
.tally > span > span { padding: 0; border: none; background: transparent; }
.tally b { font-family: var(--chunky); font-weight: 400; font-size: 32rpx; }
.tally small { font-size: 22rpx; opacity: .6; }
.tally .ng b { color: var(--violet); }
.dopa {
  display: flex; align-items: baseline; gap: 12rpx; max-width: 62%;
  padding: 6rpx 24rpx 8rpx; border: 5rpx solid var(--ink); border-radius: 24rpx; background: var(--yellow);
  box-shadow: 0 6rpx 0 var(--ink); transform-origin: right center; white-space: nowrap; overflow: hidden;
}
.dopa small { font-size: 22rpx; }
.dopa b { font-family: var(--chunky); font-weight: 400; font-size: 40rpx; letter-spacing: .01em; }
page.lv6 .dopa { background: linear-gradient(90deg, #ffd23f, #ff9ccc, #9fd0ff, #ffd23f); background-size: 300% 100%; animation: dopa-sheen 2s linear infinite; }
@keyframes dopa-sheen { to { background-position: 300% 0; } }
/* Combo (id032): floats under the tally, over the stage's top-left corner. */
.combo {
  position: absolute; left: 28rpx; top: calc(100% + 4rpx); display: grid; grid-template-columns: auto auto; align-items: baseline; column-gap: 8rpx;
  padding: 4rpx 20rpx 20rpx; border: 5rpx solid var(--ink); border-radius: 24rpx; background: #fff; box-shadow: 0 6rpx 0 var(--ink);
  transform-origin: left center; opacity: 0; visibility: hidden; transition: opacity .15s, visibility .15s; pointer-events: none;
}
.combo.on { opacity: 1; visibility: visible; }
.combo b { font-family: var(--chunky); font-weight: 400; font-size: 44rpx; line-height: 1.1; color: var(--pink); }
.combo small { font-size: 22rpx; font-weight: 900; }
.combo-mult { grid-column: 1 / -1; font-size: 20rpx; font-weight: 900; opacity: .7; }
.combo-track { position: absolute; left: 12rpx; right: 12rpx; bottom: 6rpx; height: 8rpx; border-radius: 4rpx; background: #e6e4f0; overflow: hidden; }
.combo-track i { position: absolute; inset: 0; background: var(--blue); transform-origin: left center; }
.combo.hot { background: #fff4c4; }
.combo.hot b { color: var(--red); }
.combo.hot .combo-mult { opacity: 1; color: var(--red); }
.combo.hurry .combo-track i { background: var(--red); }

.stage { position: relative; flex: 1 1 auto; min-height: 236rpx; margin: 0 28rpx; }
.ground { position: absolute; left: 6%; right: 6%; bottom: 12rpx; width: 88%; height: 28rpx; }
.bunting { position: absolute; left: -2%; right: -2%; top: 0; width: 104%; height: 68rpx; opacity: 0; transform: translateY(-40rpx); transition: opacity .5s, transform .5s cubic-bezier(.3, 1.6, .5, 1); }
page.lv3 .bunting { opacity: 1; transform: none; }
.spot { position: absolute; top: -60rpx; width: 280rpx; height: 380rpx; opacity: 0; transition: opacity .6s; mix-blend-mode: screen; filter: blur(4rpx);
  background: linear-gradient(to bottom, rgba(255, 246, 200, .95), rgba(255, 246, 200, 0)); clip-path: polygon(44% 0, 56% 0, 100% 100%, 0 100%); }
.spot-l { left: 0; transform-origin: 50% 0; animation: spot-l 3s ease-in-out infinite; }
.spot-r { right: 0; transform-origin: 50% 0; animation: spot-r 3.4s ease-in-out infinite; }
page.lv5 .spot { opacity: .7; }
@keyframes spot-l { 0%, 100% { transform: rotate(-24deg); } 50% { transform: rotate(10deg); } }
@keyframes spot-r { 0%, 100% { transform: rotate(24deg); } 50% { transform: rotate(-12deg); } }

.card {
  position: relative; margin: 0 28rpx 24rpx; padding: 20rpx 24rpx 20rpx;
  background: #fff; border: 6rpx solid var(--ink); border-radius: 48rpx; box-shadow: 0 14rpx 0 var(--ink);
  transform-origin: 50% 100%;
}
.card-top { display: flex; justify-content: space-between; align-items: center; }
.chip { display: inline-block; margin: 0; padding: 6rpx 24rpx; border-radius: 1998rpx; background: var(--blue); color: #fff; font-size: 26rpx; letter-spacing: .08em; }
.qno { font-family: var(--round); font-weight: 900; font-size: 30rpx; }
.sheet-wrap { display: flex; justify-content: center; align-items: center; min-height: 416rpx; padding: 8rpx 0 4rpx; }
.sheet { position: relative; display: grid; grid-template-columns: repeat(var(--cols), var(--cw)); grid-template-rows: repeat(var(--rows), var(--ch)); --cw: 108rpx; --ch: 104rpx; font-family: var(--round); font-weight: 900; }
.cell { position: relative; display: grid; place-items: center; font-size: calc(var(--ch) * .82); line-height: 1; font-variant-numeric: tabular-nums; }
.sheet.div .cell { font-size: calc(var(--ch) * .88); }
.cell.op { color: var(--blue); font-size: calc(var(--ch) * .7); }
.cell.small { align-self: end; font-size: clamp(24rpx, calc(var(--ch) * .38), 38rpx); color: var(--pink); height: calc(var(--ch) * .46); }
.cell.mark { color: var(--blue); font-size: clamp(22rpx, calc(var(--ch) * .34), 34rpx); letter-spacing: -.04em; }
.cell.struck::after { content: ""; position: absolute; left: 18%; right: 18%; top: 50%; height: 7rpx; background: var(--blue); border-radius: 4rpx; transform: rotate(-32deg); }
.cell.hidden { visibility: hidden; }
.cell.input { margin: 6rpx; border-radius: 24rpx; }
.cell.input.active { background: var(--blue-soft); outline: 6rpx dashed var(--blue); outline-offset: -6rpx; animation: active-cell 1s ease-in-out infinite; }
.cell.input.active::before { content: "?"; color: rgba(59, 107, 255, .35); }
.cell.input.active.has::before { content: none; }
.cell.input.ok { color: var(--ink); }
.cell.input.bad { color: #7a4bff; background: #efe8ff; outline: 6rpx dashed #a77bff; outline-offset: -6rpx; animation: none; }
.cell.hint-glow { border-radius: 16rpx; background: #fff3b8; box-shadow: 0 0 0 6rpx var(--yellow); animation: hint-glow .9s ease-in-out infinite; }
@keyframes hint-glow { 50% { box-shadow: 0 0 0 12rpx rgba(255, 210, 63, .5); } }
page.reduced .cell.hint-glow { animation: none; }
.help-text { display: inline-block; margin-left: 16rpx; padding: 2rpx 20rpx; border-radius: 1998rpx; background: var(--yellow); color: var(--ink); font-weight: 900; }
.cell.input.pending { color: transparent; }
@keyframes active-cell { 50% { background: #c4d5ff; } }
.cell.auto { color: #5a5f93; }
.hline { position: relative; align-self: end; height: 7rpx; background: var(--ink); border-radius: 4rpx; margin-bottom: -4rpx; transform-origin: left center; }
.hline.hidden { visibility: hidden; }
.bracket { position: relative; border-top: 7rpx solid var(--ink); margin-left: 8rpx; }
.bracket::before { content: ""; position: absolute; left: -28rpx; top: -7rpx; width: 28rpx; height: calc(100% + 8rpx); border-right: 7rpx solid var(--ink); border-radius: 0 70% 70% 0 / 0 50% 50% 0; }
.step-label { margin: 4rpx 0 0; text-align: center; font-size: 28rpx; min-height: 40rpx; }
.step-label b { color: var(--blue); }

.stamp {
  position: absolute; right: 28rpx; top: 68rpx; width: 220rpx; height: 220rpx; border-radius: 50%; border: 18rpx solid var(--red); opacity: 0;
  box-shadow: inset 0 0 0 6rpx rgba(255, 79, 109, .3); pointer-events: none;
}
.reach-tag {
  position: absolute; left: 50%; bottom: -40rpx; transform: translateX(-50%) scale(0); z-index: 3; padding: 8rpx 32rpx; border-radius: 1998rpx;
  background: var(--ink); color: var(--yellow); font-family: var(--chunky); font-size: 36rpx; letter-spacing: .1em; white-space: nowrap; border: 6rpx solid var(--yellow);
}
page.reach .reach-tag { animation: reach-blink .3s steps(2) infinite; }
@keyframes reach-blink { 50% { color: #fff; border-color: var(--pink); } }
page.reach .cell.input.active { outline: 8rpx solid var(--yellow); background: #fff3b8; animation: reach-cell .25s steps(2) infinite; box-shadow: 0 0 0 12rpx var(--pink), 0 0 48rpx 16rpx rgba(255, 210, 63, .9); z-index: 2; }
@keyframes reach-cell { 50% { box-shadow: 0 0 0 12rpx var(--blue), 0 0 60rpx 24rpx rgba(255, 122, 182, .9); } }
page.reach .card { z-index: 3; }

.marquee { position: absolute; inset: -18rpx; border-radius: 60rpx; pointer-events: none; opacity: 0; transition: opacity .6s; padding: 10rpx;
  background: radial-gradient(circle, #fff 0 5rpx, var(--yellow) 6rpx 9rpx, transparent 10rpx) 0 0 / 32rpx 32rpx;
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  animation: marquee .5s linear infinite; }
page.lv6 .marquee { opacity: 1; }
page.lv8 .marquee { background: radial-gradient(circle, #fff 0 5rpx, var(--pink) 6rpx 9rpx, transparent 10rpx) 0 0 / 32rpx 32rpx, radial-gradient(circle, #fff 0 5rpx, var(--yellow) 6rpx 9rpx, transparent 10rpx) 16rpx 16rpx / 32rpx 32rpx; }
@keyframes marquee { to { background-position: 32rpx 0, 48rpx 16rpx; } }
page.lv9 .card { box-shadow: 0 14rpx 0 var(--ink), 0 0 0 10rpx var(--pink), 0 0 80rpx 20rpx rgba(255, 210, 63, calc(.4 + var(--kick) * .6)); }

.pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18rpx; padding: 0 28rpx; }
.pad button {
  position: relative; height: clamp(100rpx, 7.4dvh, 124rpx); border: 6rpx solid var(--ink); border-radius: 36rpx; background: #fff;
  font-family: var(--round); font-weight: 900; font-size: 60rpx; box-shadow: 0 10rpx 0 var(--ink);
  transform: translateY(calc(var(--kick) * -4rpx * var(--bounce, 0)));
}
.pad button.zero { grid-column: span 2; }
.pad button.del { background: var(--pink-soft); font-size: 48rpx; }
.pad button.press { transform: translateY(8rpx) scale(.97); box-shadow: 0 2rpx 0 var(--ink); }
page.lv4 .pad button { --bounce: 1; }
page.lv4 .pad button[data-key="7"], page.lv4 .pad button[data-key="3"] { background: #ffe3ef; }
page.lv4 .pad button[data-key="8"], page.lv4 .pad button[data-key="4"] { background: #fff4c7; }
page.lv4 .pad button[data-key="9"], page.lv4 .pad button[data-key="5"], page.lv4 .pad button[data-key="1"] { background: #e3ebff; }
page.lv4 .pad button[data-key="6"], page.lv4 .pad button[data-key="2"], page.lv4 .pad button[data-key="0"] { background: #dcfaef; }
page.lv8 .pad button { box-shadow: 0 10rpx 0 var(--ink), 0 0 calc(var(--kick) * 36rpx) rgba(255, 210, 63, .9); }
.pad button:disabled { opacity: .5; }

/* ------------------------------------------------------------ results */
#screen-result, #screen-final { align-items: safe center; justify-content: center; padding: 40rpx 32rpx; overflow-y: auto; }
#screen-result .result-card, #screen-final .result-card { margin: auto 0; flex: none; }
.actions .review-btn { font-size: 32rpx; white-space: nowrap; padding: 0 32rpx; }
.result-card {
  width: 100%; padding: 44rpx 40rpx 40rpx; text-align: center; background: #fff; border: 7rpx solid var(--ink); border-radius: 56rpx; box-shadow: 0 18rpx 0 var(--ink);
}
.score { margin: 16rpx 0 0; font-family: var(--chunky); line-height: 1; }
.score b { font-weight: 400; font-size: 184rpx; color: var(--pink); text-shadow: 6rpx 0 0 var(--ink), -6rpx 0 0 var(--ink), 0 6rpx 0 var(--ink), 0 -6rpx 0 var(--ink), 0 16rpx 0 var(--ink); }
.score span { font-size: 56rpx; margin-left: 8rpx; font-family: var(--round); font-weight: 900; }
.stats dd small { font-family: var(--round); font-weight: 900; font-size: 28rpx; margin-left: 4rpx; }
.breakdown { margin: 16rpx 0 0; font-size: 30rpx; }
.stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 36rpx 0 20rpx; }
.stats div { padding: 16rpx; border: 5rpx solid var(--ink); border-radius: 28rpx; background: var(--paper); }
.stats dt { font-size: 24rpx; opacity: .7; }
.stats dd { margin: 4rpx 0 0; font-family: var(--chunky); font-size: 44rpx; }
.dopa-final { margin: 12rpx 0 0; }
.dopa-final small { font-size: 24rpx; margin-right: 12rpx; }
.dopa-final b { font-family: var(--chunky); font-weight: 400; font-size: 48rpx; color: var(--blue); }
.unlock { min-height: 40rpx; font-size: 28rpx; margin: 20rpx 0 24rpx; }
.unlock.yes { color: var(--pink); }
.actions { display: flex; flex-direction: column; align-items: center; gap: 24rpx; margin-top: 16rpx; }

/* ------------------------------------------------------------ cut-ins */
.cutin-band { position: absolute; left: -20%; width: 140%; display: flex; align-items: center; justify-content: center; transform-origin: center; }
.cutin-band .band-bg { position: absolute; inset: 0; border-top: 8rpx solid var(--ink); border-bottom: 8rpx solid var(--ink);
  background: repeating-linear-gradient(-45deg, var(--c1) 0 44rpx, var(--c2) 44rpx 88rpx); }
.cutin-band .band-text { position: relative; font-family: var(--chunky); color: #fff; font-size: 88rpx; letter-spacing: .08em; white-space: nowrap;
  text-shadow: 6rpx 0 0 var(--ink), -6rpx 0 0 var(--ink), 0 6rpx 0 var(--ink), 0 -6rpx 0 var(--ink), 0 14rpx 0 var(--ink); }
.unit-slam { position: absolute; font-family: var(--chunky); color: var(--yellow); white-space: nowrap; transform-origin: center;
  text-shadow: 8rpx 0 0 var(--ink), -8rpx 0 0 var(--ink), 0 8rpx 0 var(--ink), 0 -8rpx 0 var(--ink), 6rpx 6rpx 0 var(--ink), -6rpx 6rpx 0 var(--ink), 6rpx -6rpx 0 var(--ink), -6rpx -6rpx 0 var(--ink), 0 20rpx 0 var(--pink); }
.big-stamp { position: absolute; font-family: var(--chunky); color: var(--red); white-space: nowrap; transform-origin: center; }

page.reduced .logo span, page.reduced .spot, page.reduced .marquee, page.reduced .pip.now, page.reduced .cell.input.active { animation: none !important; }
@media (max-height:1680rpx) {
  /* Include toolbar-reduced phone heights and leave room for the bottom safe area. */
  .sheet-wrap { min-height: clamp(192rpx, calc(100dvh - 980rpx - 0rpx), 352rpx); }
  #screen-play .card { padding-block: 16rpx; margin-bottom: 20rpx; }
  .pad { gap: 12rpx; }
  .pad button { height: 96rpx; }
  .stage { min-height: 160rpx; }
}
@media (max-height:1200rpx) {
  .stage { min-height: 96rpx; }
  .step-label { font-size: 24rpx; }
}

/* ------------------------------------------------------------ calendar */
.cal-card { width: 100%; max-width: 840rpx; padding: 24rpx 24rpx 28rpx; border: 6rpx solid var(--ink); border-radius: 44rpx; background: #fff; box-shadow: 0 12rpx 0 var(--ink); }
.cal-head { display: flex; align-items: center; justify-content: space-between; }
.cal-head h2 { margin: 0; font-family: var(--chunky); font-weight: 400; font-size: 40rpx; }
.cal-nav { width: 80rpx; height: 80rpx; border: 5rpx solid var(--ink); border-radius: 50%; background: var(--paper); font-size: 48rpx; line-height: 1; font-weight: 900; }
.cal-nav:disabled { opacity: .3; }
.cal-streak { margin: 8rpx 0 12rpx; min-height: 1.2em; text-align: center; font-size: 28rpx; font-weight: 900; color: var(--pink); }
.cal-streak b { font-family: var(--chunky); font-weight: 400; font-size: 40rpx; margin: 0 4rpx; }
.cal-week, .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6rpx; }
.cal-week span { text-align: center; font-size: 22rpx; font-weight: 900; opacity: .6; }
.cal-week span:first-child { color: var(--red); }
.cal-week span:last-child { color: var(--blue); }
.cal-day { position: relative; aspect-ratio: 1 / 1.08; min-height: 80rpx; padding: 0; border: 0; border-radius: 20rpx; background: var(--paper); font-size: 22rpx; font-weight: 900; color: var(--ink); }
.cal-day .n { position: absolute; left: 8rpx; top: 4rpx; opacity: .55; }
.cal-day.blank { background: transparent; }
.cal-day.today { box-shadow: inset 0 0 0 5rpx var(--blue); }
.cal-day.played { background: #fff0f6;  }
.cal-day.played svg { position: absolute; inset: 8% 6% 2%; width: 88%; height: 90%; }
.cal-day .sc { position: absolute; left: 0; right: 0; bottom: 18%; text-align: center; font-family: var(--chunky); font-weight: 400; font-size: 24rpx; color: var(--red); letter-spacing: -.03em; text-shadow: 3rpx 0 0 #fff, -3rpx 0 0 #fff, 0 3rpx 0 #fff, 0 -3rpx 0 #fff; }
.cal-day .sc.big { font-size: 20rpx; }
.cal-day.pop { animation: cal-pop .7s cubic-bezier(.3, 1.8, .5, 1) both; }
@keyframes cal-pop { 0% { transform: scale(0) rotate(-30deg); } 100% { transform: scale(1) rotate(0); } }
.day-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16rpx; }
.day-list li { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 8rpx 20rpx; padding: 16rpx 24rpx; border: 5rpx solid var(--ink); border-radius: 28rpx; background: #fff; font-size: 26rpx; }
.day-list .t { font-weight: 900; opacity: .6; }
.day-list .m { font-weight: 900; }
.day-list .s { font-family: var(--chunky); font-weight: 400; font-size: 40rpx; color: var(--red); grid-row: span 2; }
.day-list .d { grid-column: 1 / 3; font-size: 24rpx; opacity: .75; }

/* ------------------------------------------------------------ expression layouts */
.cell.word { font-size: calc(var(--ch) * .46); white-space: nowrap; color: #4a4f86; }
.sheet.h .cell.op { font-size: calc(var(--ch) * .62); }
.cell.dot { justify-self: end; align-self: stretch; height: 100%; width: 0; overflow: visible; font-size: calc(var(--ch) * .82); line-height: 1; color: var(--ink); pointer-events: none; z-index: 1; display: flex; align-items: center; justify-content: center; }
.cell.dot.hidden { visibility: hidden; }
.cell.frac-n { align-self: end; }
.cell.frac-d { align-self: start; }
.cell.input.frac-n, .cell.input.frac-d { margin: 4rpx 6rpx; }
.hline.fbar { margin: 0 8rpx -4rpx; }

/* ------------------------------------------------------------ modes */
.level-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 156rpx; gap: 4rpx; background: var(--pink); }
.level-btn small { font-size: 26rpx; letter-spacing: 0; }
.grades { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; width: min(100%, 680rpx); }
.grades button { height: 104rpx; border: 6rpx solid var(--ink); border-radius: 32rpx; background: #fff; font-family: var(--chunky); font-size: 48rpx; box-shadow: 0 8rpx 0 var(--ink); }
.grades button small { font-family: var(--round); font-weight: 900; font-size: 24rpx; margin-left: 4rpx; }
.grades button:nth-child(6n+1) { background: #ffe3ef; } .grades button:nth-child(6n+2) { background: #e3ebff; } .grades button:nth-child(6n+3) { background: #fff4c4; }
.grades button:nth-child(6n+4) { background: #d9fbef; } .grades button:nth-child(6n+5) { background: #efe6ff; } .grades button:nth-child(6n+6) { background: #ffe6dc; }
.grades button:active { transform: translateY(8rpx); box-shadow: 0 2rpx 0 var(--ink); }
.mode-row { display: flex; gap: 20rpx; flex-wrap: wrap; justify-content: center; }
.mode-row .sub-btn { min-width: 300rpx; font-weight: 900; }
.mode-row .sub-btn b, .review-btn b { font-family: var(--chunky); font-weight: 400; color: var(--pink); margin-left: 8rpx; }
.review-btn { background: #fff4c4; }

/* ------------------------------------------------------------ skill tree */
#screen-tree { flex-direction: column; padding: calc(20rpx + 0rpx) 0 0; }
.tree-head { display: flex; align-items: center; gap: 20rpx; padding: 0 28rpx 12rpx; }
.tree-head h2 { margin: 0; flex: 1; font-family: var(--chunky); font-weight: 400; font-size: 44rpx; }
.tree-head .icon-btn { font-size: 52rpx; font-weight: 900; line-height: 1; }
.tree-count { font-family: var(--chunky); font-size: 32rpx; padding: 8rpx 20rpx; border: 5rpx solid var(--ink); border-radius: 1998rpx; background: #fff; }
.tree-lanes { position: sticky; top: 0; z-index: 2; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; padding: 0 6rpx 8rpx; background: var(--paper); box-sizing: border-box; }
.tree-lanes span { text-align: center; font-size: 22rpx; font-weight: 900; padding: 6rpx 0; border-radius: 1998rpx; background: var(--ink); color: #fff; }
.tree-scroll { flex: 1; overflow: auto;  padding: 0 12rpx calc(80rpx + 0rpx); }
.tree { position: relative; }
.tree-links { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.tree-links path { fill: none; stroke: #c9cbe8; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
.tree-links path.on { stroke: var(--ink); }
.tree-links path.grow { stroke: var(--pink); stroke-width: 5; }
.node { position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; padding: 8rpx 6rpx 6rpx; border: 5rpx solid var(--ink); border-radius: 28rpx; background: #fff; box-shadow: 0 6rpx 0 var(--ink); font-size: 21rpx; font-weight: 900; line-height: 1.15; text-align: center; color: var(--ink); word-break: keep-all; overflow-wrap: anywhere; }
.node .g { font-size: 18rpx; opacity: .6; }
.node .ring { position: absolute; left: 8rpx; right: 8rpx; bottom: 6rpx; height: 8rpx; border-radius: 6rpx; background: linear-gradient(90deg, var(--pink) calc(var(--p) * 100%), #eee calc(var(--p) * 100%)); }
.node.locked { background: #eceaf3; color: #8a8cb0; border-color: #a9abc9; box-shadow: 0 6rpx 0 #a9abc9; }
.node.locked::before { content: ""; position: absolute; top: -16rpx; right: -12rpx; width: 32rpx; height: 26rpx; border-radius: 6rpx; background: #a9abc9; box-shadow: inset 0 0 0 4rpx #8a8cb0; }
.node.locked::after { content: ""; position: absolute; top: -30rpx; right: -4rpx; width: 16rpx; height: 18rpx; border: 5rpx solid #8a8cb0; border-bottom: 0; border-radius: 12rpx 12rpx 0 0; }
.node.new { background: #fff4c4; animation: node-new 1.1s ease-in-out infinite; }
.node.new::after { content: "NEW"; position: absolute; top: -20rpx; right: -16rpx; padding: 2rpx 10rpx; border-radius: 1998rpx; background: var(--pink); color: #fff; font-family: var(--chunky); font-weight: 400; font-size: 20rpx; border: 4rpx solid var(--ink); }
.node.learning { background: #e3ebff; }
.node.mastered { background: linear-gradient(160deg, #fff6c8, #ffd23f); }
.node.mastered::after { content: "★"; position: absolute; top: -24rpx; right: -12rpx; font-size: 40rpx; color: #ffb000; -webkit-text-stroke: 3rpx var(--ink); }
.node.just { animation: node-pop .8s cubic-bezier(.3, 1.8, .5, 1) both; }
@keyframes node-new { 50% { transform: translateY(-6rpx); } }
@keyframes node-pop { 0% { transform: scale(0) rotate(-20deg); } 100% { transform: scale(1); } }
page.reduced .node { animation: none !important; }
/* Long press to erase (id031): a pink fill rises while held. */
.node { -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; overflow: visible; }
.node .hold { position: absolute; inset: 0; border-radius: 22rpx; background: rgba(255, 79, 109, .35); transform-origin: bottom; transform: scaleY(0); pointer-events: none; }
.node.holding .hold { transform: scaleY(1); transition: transform var(--hold-ms, 600ms) linear; }
.node.holding { transform: scale(.94); transition: transform .12s; }
.node.erased { animation: node-erase .6s ease-out both; }
@keyframes node-erase { 0% { transform: scale(1.12) rotate(4deg); filter: brightness(1.4); } 40% { transform: scale(.9) rotate(-3deg); } 100% { transform: none; } }
.tree-note { margin: 0 0 8rpx; text-align: center; font-size: 22rpx; font-weight: 900; opacity: .6; }
.confirm-msg { margin: 0; word-break: keep-all; overflow-wrap: anywhere; font-size: 30rpx; font-weight: 900; line-height: 1.6; text-align: center; }
.confirm-msg b { color: var(--red); }
.confirm-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; margin: 0; padding: 0; list-style: none; }
.confirm-list li { padding: 6rpx 18rpx; border: 4rpx solid var(--ink); border-radius: 1998rpx; background: #fff; font-size: 24rpx; font-weight: 900; }
.confirm-list li.more { border-style: dashed; background: transparent; }
.confirm-actions { display: flex; justify-content: center; gap: 24rpx; }
.confirm-actions .sub-btn { min-width: 240rpx; font-weight: 900; }
.sub-btn.danger { background: var(--red); color: #fff; text-shadow: 0 4rpx 0 rgba(27, 29, 77, .45); }
.toast { position: absolute; left: 32rpx; right: 32rpx; bottom: calc(36rpx + 0rpx); margin: 0; padding: 20rpx 28rpx; border: 6rpx solid var(--ink); border-radius: 32rpx; background: #fff; box-shadow: 0 10rpx 0 var(--ink); font-weight: 900; font-size: 28rpx; text-align: center; z-index: 3; pointer-events: none; }
.skill-news { display: flex; flex-direction: column; gap: 12rpx; width: 100%; }
.skill-news:empty { display: none; }
.skill-news p { margin: 0; padding: 12rpx 20rpx; border: 5rpx solid var(--ink); border-radius: 24rpx; background: #fff4c4; font-size: 26rpx; font-weight: 900; text-align: center; }
.skill-news p.mastered { background: linear-gradient(160deg, #fff6c8, #ffd23f); }

/* ------------------------------------------------------------ demo play */
.demo-btn { align-self: center; min-width: 460rpx; font-weight: 900; background: #e3ebff; }
.demo-tag { display: none; padding: 6rpx 20rpx; border-radius: 1998rpx; background: var(--red); color: #fff; font-family: var(--chunky); font-size: 26rpx; letter-spacing: .08em; border: 5rpx solid var(--ink); animation: demo-blink 1.2s steps(2) infinite; }
page.demo .demo-tag { display: inline-block; }
@keyframes demo-blink { 50% { opacity: .45; } }
page.reduced .demo-tag { animation: none; }

/* ------------------------------------------------------------ streak & login bonus */
.cal-badges { display: flex; justify-content: center; gap: 16rpx; flex-wrap: wrap; margin: 12rpx 0 16rpx; min-height: 60rpx; }
.cal-badge { display: inline-flex; align-items: baseline; gap: 6rpx; padding: 6rpx 24rpx; border: 5rpx solid var(--ink); border-radius: 1998rpx; background: #fff; font-size: 24rpx; font-weight: 900; }
.cal-badge b { font-family: var(--chunky); font-weight: 400; font-size: 40rpx; color: var(--pink); }
.cal-badge.hot { background: linear-gradient(90deg, #ffd23f, #ff9a3c); }
.cal-badge.hot b { color: var(--ink); }
.cal-badge.best b { color: var(--blue); }
.cal-badge.stk b { color: #ffb000; }
.cal-day .stk { position: absolute; top: 2rpx; right: 2rpx; width: 44%; height: 44%; pointer-events: none; }
.cal-day .stk svg { position: static; width: 100%; height: 100%; inset: auto; }
.bonus-card { align-items: center; text-align: center; }
.bonus-run { margin: 0; font-weight: 900; font-size: 30rpx; }
.bonus-run b { font-family: var(--chunky); font-weight: 400; font-size: 60rpx; color: var(--pink); margin: 0 8rpx; }
.bonus-card-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; width: 100%; }
.bonus-slot { position: relative; min-width: 0; aspect-ratio: 1; overflow: hidden; display: grid; place-items: center; border: 5rpx dashed #b9bbd8; border-radius: 32rpx; background: #fff; font-family: var(--chunky); font-size: 36rpx; color: #c4c6de; }
.bonus-slot.got { border-style: solid; border-color: var(--ink); background: #fff4c4; }
.bonus-slot.today { border-color: var(--pink); box-shadow: 0 0 0 8rpx rgba(255, 122, 182, .35); }
.bonus-slot.big { background: linear-gradient(160deg, #fff6c8, #ffd23f); color: var(--ink); border-style: solid; border-color: #ffb000; }
.bonus-slot .d { position: absolute; left: 12rpx; top: 6rpx; font-size: 22rpx; color: #8a8cb0; font-family: var(--round); font-weight: 900; }
.bonus-slot svg { display: block; width: 72%; height: 72%; }
.bonus-slot.big svg { width: 86%; height: 86%; }
.bonus-slot.stamping svg { animation: stamp-in .6s cubic-bezier(.3, 1.8, .5, 1) both .35s; }
@keyframes stamp-in { 0% { transform: scale(2.6) rotate(-25deg); opacity: 0; } 60% { opacity: 1; } 100% { transform: scale(1) rotate(0); } }
page.reduced .bonus-slot.stamping svg { animation: none; }
.bonus-note { margin: 0; font-size: 26rpx; font-weight: 900; opacity: .75; }

/* ------------------------------------------------------------ no-count hammer (id034) */
.hammer-card { align-items: center; text-align: center; }
.hammer-art { width: 220rpx; height: 220rpx; transform: rotate(-24deg); filter: drop-shadow(0 10rpx 0 rgba(27, 29, 77, .85)); }
.hammer-art svg { width: 100%; height: 100%; }
.hammer-msg { margin: 0; font-size: 32rpx; font-weight: 900; line-height: 1.7; word-break: keep-all; }
.hammer-msg b { font-family: var(--chunky); font-weight: 400; color: var(--pink); font-size: 1.25em; margin: 0 4rpx; }
.hammer-have { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin: 0; font-size: 26rpx; font-weight: 900; }
.hammer-have i { display: inline-block; width: 60rpx; height: 60rpx; opacity: .22; filter: grayscale(1); }
.hammer-have i.on { opacity: 1; filter: none; }
.hammer-have svg, .cal-badge.hmr svg { width: 100%; height: 100%; display: block; }
.sub-btn.hammer-yes { background: var(--pink); color: #fff; text-shadow: 0 4rpx 0 rgba(27, 29, 77, .45); }
.cal-badge.hmr { align-items: center; }
.cal-badge.hmr i { width: 44rpx; height: 44rpx; margin-right: 4rpx; transform: rotate(-20deg); }
.cal-badge.hmr b { color: var(--blue); }
.cal-day.nocount { background: #efe8ff; }
.cal-day .nc { position: absolute; left: 50%; top: 56%; transform: translate(-50%, -50%) rotate(-14deg); padding: 2rpx 6rpx; border: 4rpx solid #7a4bff; border-radius: 10rpx; color: #7a4bff; font-size: 18rpx; font-weight: 900; letter-spacing: -.04em; white-space: nowrap; background: rgba(255, 255, 255, .7); }
.cal-day.stamped .nc { animation: nc-stamp .5s cubic-bezier(.3, 1.8, .5, 1) both; }
@keyframes nc-stamp { 0% { transform: translate(-50%, -50%) rotate(-30deg) scale(2.6); opacity: 0; } 100% { transform: translate(-50%, -50%) rotate(-14deg) scale(1); opacity: 1; } }
.hammer-fx { position: absolute; width: 200rpx; height: 200rpx; transform-origin: 100rpx 188rpx; filter: drop-shadow(0 8rpx 0 rgba(27, 29, 77, .8)); }
.hammer-fx svg { width: 100%; height: 100%; display: block; }

/* ------------------------------------------------------------ daily quests (id035) */
.quest-card { width: 100%; max-width: 840rpx; padding: 20rpx 24rpx 24rpx; border: 6rpx solid var(--ink); border-radius: 44rpx; background: #fff; box-shadow: 0 12rpx 0 var(--ink); }
.quest-card.complete { background: linear-gradient(160deg, #fffbe6, #fff2b8); }
.quest-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.quest-head h2 { margin: 0; font-family: var(--chunky); font-weight: 400; font-size: 36rpx; }
.quest-reward, .qm-head span { display: inline-flex; align-items: center; gap: 4rpx; font-size: 24rpx; font-weight: 900; white-space: nowrap; }
.qham { display: inline-block; width: 44rpx; height: 44rpx; transform: rotate(-20deg); vertical-align: middle; }
.qham svg { width: 100%; height: 100%; display: block; }
.qdone { color: var(--pink); font-family: var(--chunky); font-weight: 400; font-size: 30rpx; }
.quest-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10rpx; }
.quest-list li { position: relative; display: grid; grid-template-columns: 52rpx 1fr auto; align-items: center; gap: 16rpx; padding: 12rpx 20rpx 18rpx 12rpx; border: 5rpx solid var(--ink); border-radius: 28rpx; background: var(--paper); font-size: 28rpx; font-weight: 900; overflow: hidden; }
.quest-list li.done { background: #dff8ec; }
.quest-list li.go {  background: #fff4c4; box-shadow: 0 6rpx 0 var(--ink); }
.quest-list li.go::after { content: "▶"; position: absolute; right: 16rpx; top: 50%; transform: translateY(-50%); font-size: 20rpx; opacity: .55; }
.quest-list li.go .qp { margin-right: 24rpx; }
.qchk { width: 48rpx; height: 48rpx; border: 5rpx solid var(--ink); border-radius: 50%; background: #fff; color: #fff; display: grid; place-items: center; }
.qchk svg { width: 34rpx; height: 34rpx; }
li.done .qchk { background: var(--mint); }
.qt { word-break: keep-all; overflow-wrap: anywhere; line-height: 1.3; }
.qp { font-family: var(--chunky); font-weight: 400; font-size: 28rpx; color: var(--blue); }
li.done .qp { color: #1f9e76; }
.qbar { position: absolute; left: 16rpx; right: 16rpx; bottom: 6rpx; height: 6rpx; border-radius: 4rpx; background: linear-gradient(90deg, var(--pink) calc(var(--p) * 100%), rgba(27, 29, 77, .12) calc(var(--p) * 100%)); }
li.done .qbar { background: var(--mint); }
.quest-mini { width: 100%; margin: 8rpx 0 20rpx; text-align: left; }
.quest-mini:empty { display: none; }
.qm-head { display: flex; justify-content: space-between; align-items: center; margin: 0 0 10rpx; font-size: 26rpx; font-weight: 900; }
.quest-mini .quest-list li { font-size: 25rpx; padding: 8rpx 16rpx 14rpx 10rpx; grid-template-columns: 44rpx 1fr auto; }
.quest-mini .qchk { width: 40rpx; height: 40rpx; }
.qm-got { margin: 16rpx 0 0; padding: 12rpx 20rpx; border: 5rpx solid var(--ink); border-radius: 24rpx; background: linear-gradient(160deg, #fff6c8, #ffd23f); font-size: 26rpx; font-weight: 900; text-align: center; }
.quest-pop { position: absolute; left: 50%; display: flex; flex-direction: column; align-items: center; padding: 12rpx 32rpx 14rpx; border: 6rpx solid var(--ink); border-radius: 32rpx; background: #fff; box-shadow: 0 10rpx 0 var(--ink); font-size: 26rpx; font-weight: 900; white-space: nowrap; transform: translate(-50%, 0); opacity: 0; }
.quest-pop b { font-family: var(--chunky); font-weight: 400; font-size: 32rpx; color: var(--pink); }
.quest-pop.all { background: linear-gradient(160deg, #fff6c8, #ffd23f); }
.quest-pop.all b { color: var(--ink); font-size: 40rpx; }
.cal-day .qd { position: absolute; left: 4rpx; bottom: 2rpx; width: 30rpx; height: 30rpx; border: 3rpx solid var(--ink); border-radius: 50%; background: var(--yellow); color: #fff; font-size: 18rpx; line-height: 24rpx; text-align: center; -webkit-text-stroke: .12rpx var(--ink); }

/* ------------------------------------------------------------ trophies (id036) */
.trophy-card { align-items: center; text-align: center; }
.tg-sub { margin: 0; font-size: 30rpx; font-weight: 900; }
.tg-sub:empty { display: none; }
.tg-sub b { font-family: var(--chunky); font-weight: 400; font-size: 48rpx; color: var(--pink); margin: 0 4rpx; }
.tg-list { list-style: none; margin: 0; padding: 0; width: 100%; display: flex; flex-direction: column; gap: 14rpx; }
.tg-list li { display: grid; grid-template-columns: 88rpx 1fr; align-items: center; gap: 20rpx; padding: 12rpx 24rpx 12rpx 12rpx; border: 5rpx solid var(--ink); border-radius: 32rpx; background: #fff; text-align: left; transition: opacity .15s; }
.tg-list li i { width: 88rpx; height: 88rpx; }
.tg-list li svg, .tr-icon svg, .tr-series li i svg { width: 100%; height: 100%; display: block; }
.tg-list li b { display: block; font-size: 30rpx; font-weight: 900; }
.tg-list li small { display: block; font-size: 23rpx; opacity: .72; line-height: 1.35; }
.tg-list li.r-gold { background: #fff6cf; } .tg-list li.r-rainbow { background: linear-gradient(120deg, #ffe3ef, #fff4c4, #dcfaef, #e3ebff); } .tg-list li.r-secret { background: #efe6ff; }
.tg-list li.more { display: block; text-align: center; border-style: dashed; font-size: 26rpx; font-weight: 900; }
#screen-trophy { flex-direction: column; padding: calc(20rpx + 0rpx) 0 0; }
.tr-filter { display: flex; justify-content: center; gap: 16rpx; padding: 0 28rpx 16rpx; }
.tr-filter button { height: 68rpx; padding: 0 28rpx; border: 5rpx solid var(--ink); border-radius: 1998rpx; background: #fff; font-size: 26rpx; font-weight: 900; }
.tr-filter button[aria-pressed="true"] { background: var(--ink); color: #fff; }
.tr-scroll { flex: 1; overflow: auto;  padding: 0 28rpx calc(80rpx + 0rpx); }
.tr-cat { margin: 28rpx 0 12rpx; font-family: var(--chunky); font-weight: 400; font-size: 32rpx; }
.tr-cat:first-child { margin-top: 4rpx; }
.tr-series { margin-bottom: 16rpx; border: 5rpx solid var(--ink); border-radius: 32rpx; background: #fff; box-shadow: 0 6rpx 0 var(--ink); overflow: hidden; }
.tr-series summary { list-style: none; display: grid; grid-template-columns: 80rpx 1fr auto; grid-template-rows: auto auto; align-items: center; column-gap: 20rpx; padding: 14rpx 24rpx 16rpx 14rpx;  }
.tr-series summary::-webkit-details-marker { display: none; }
.tr-icon { grid-row: span 2; width: 80rpx; height: 80rpx; }
.tr-t { display: flex; flex-direction: column; min-width: 0; }
.tr-t b { font-size: 28rpx; font-weight: 900; }
.tr-next { font-size: 23rpx; opacity: .75; word-break: keep-all; overflow-wrap: anywhere; line-height: 1.35; }
.tr-next.done { color: var(--pink); opacity: 1; font-weight: 900; }
.tr-n { font-family: var(--chunky); font-size: 30rpx; color: var(--blue); }
.tr-dots { grid-column: 2 / 4; display: flex; flex-wrap: wrap; gap: 6rpx; margin-top: 8rpx; }
.tr-dots i { width: 18rpx; height: 18rpx; border-radius: 50%; border: 3rpx solid #b9bbd8; background: #fff; }
.tr-dots i.on { border-color: var(--ink); background: #eea36b; }
.tr-dots i.on.r-silver { background: #dde3ee; } .tr-dots i.on.r-gold { background: var(--yellow); } .tr-dots i.on.r-rainbow { background: conic-gradient(#ff7ab6, #ffd23f, #3fdcb0, #3b6bff, #ff7ab6); } .tr-dots i.on.r-secret { background: var(--violet); }
.tr-series[open] summary { border-bottom: 4rpx dashed #c9cbe8; }
.tr-series ul { list-style: none; margin: 0; padding: 12rpx 16rpx 16rpx; display: flex; flex-direction: column; gap: 8rpx; }
.tr-series li { display: grid; grid-template-columns: 60rpx 1fr auto; align-items: center; gap: 16rpx; padding: 6rpx 12rpx; border-radius: 20rpx; font-size: 24rpx; }
.tr-series li i { width: 60rpx; height: 60rpx; }
.tr-series li b { display: block; font-weight: 900; }
.tr-series li small { display: block; font-size: 21rpx; opacity: .7; }
.tr-series li:not(.got) { opacity: .6; }
.tr-series li.got { background: #fffbe6; }
.tr-series li em { font-style: normal; font-size: 22rpx; font-weight: 900; color: var(--blue); }
.tr-empty { text-align: center; font-weight: 900; opacity: .6; }

/* ------------------------------------------------------------ skill stars (id037) */
.star-row path { fill: #fff; stroke: #b9bbd8; stroke-width: 1.8; stroke-linejoin: round; }
.star-row path.on { fill: var(--yellow); stroke: var(--ink); }
.node.mastered::after { content: none; }
.node .stars { position: absolute; left: 50%; bottom: -28rpx; transform: translateX(-50%); display: block; width: 100rpx; height: 22rpx; padding: 2rpx 6rpx; border: 3rpx solid var(--ink); border-radius: 1998rpx; background: #fff; line-height: 0; box-sizing: content-box; }
.node .stars .star-row { width: 100%; height: 100%; }
.node .stars.s5 { background: linear-gradient(90deg, #ffe3ef, #fff4c4, #dcfaef, #e3ebff); }
.node.star-up .stars { animation: star-pop .8s cubic-bezier(.3, 1.8, .5, 1) both .3s; }
@keyframes star-pop { 0% { transform: translateX(-50%) scale(.2); } 100% { transform: translateX(-50%) scale(1); } }
.tree { padding-top: 12rpx; }
.tree-stars { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin: -4rpx 0 4rpx; font-size: 24rpx; font-weight: 900; }
.tree-stars .star-row { width: 32rpx; height: 32rpx; }
.tree-stars b { font-family: var(--chunky); font-weight: 400; font-size: 32rpx; color: #d99400; }
.skill-news p.star-up { display: flex; align-items: center; justify-content: center; gap: 16rpx; background: linear-gradient(90deg, #fff6c8, #ffe3ef); }
.skill-news p.star-up .star-row { width: 140rpx; height: 28rpx; flex: none; }
.si-card { align-items: center; text-align: center; gap: 20rpx; }
.si-grade { margin: 0; font-size: 24rpx; font-weight: 900; opacity: .65; }
.si-title { margin: 0; font-family: var(--chunky); font-weight: 400; font-size: 48rpx; line-height: 1.2; word-break: keep-all; overflow-wrap: anywhere; }
.si-stars { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin: 0; font-weight: 900; font-size: 26rpx; }
.si-stars .star-row { width: 380rpx; height: 76rpx; }
.si-next { width: 100%; padding: 20rpx 24rpx; border: 5rpx dashed var(--ink); border-radius: 32rpx; background: #fff; }
.si-next p { margin: 0; }
.si-label { font-family: var(--chunky); font-size: 30rpx; color: #d99400; }
.si-text { font-size: 30rpx; font-weight: 900; line-height: 1.5; word-break: keep-all; overflow-wrap: anywhere; }
.si-text.done { color: var(--pink); }
.si-now { margin-top: 8rpx !important; font-size: 26rpx; font-weight: 900; color: var(--blue); }
.si-note { margin: 0; font-size: 24rpx; font-weight: 900; opacity: .7; }
.sub-btn.si-go { background: var(--blue); color: #fff; text-shadow: 0 4rpx 0 rgba(27, 29, 77, .45); }

/* ------------------------------------------------------------ compared with before (id038) */
.growth-box { display: flex; flex-direction: column; gap: 12rpx; margin: 20rpx 0 0; padding: 16rpx 20rpx 20rpx; border: 5rpx solid var(--ink); border-radius: 32rpx; background: linear-gradient(160deg, #e3ebff, #dcfaef); }
.growth-box:empty { display: none; }
.gb-head { margin: 0; font-family: var(--chunky); font-weight: 400; font-size: 36rpx; color: var(--blue); }
.gb-line { display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 10rpx 12rpx; border-radius: 24rpx; background: #fff; }
.gb-line > b { font-size: 26rpx; font-weight: 900; }
.gb-row { display: flex; align-items: flex-end; justify-content: center; gap: 16rpx; }
.gb-what { font-size: 22rpx; font-weight: 900; opacity: .7; padding-bottom: 6rpx; }
.gb-old, .gb-new { display: flex; flex-direction: column; align-items: center; line-height: 1.1; }
.gb-old small, .gb-new small { font-size: 20rpx; font-weight: 900; opacity: .6; }
.gb-old { font-size: 28rpx; font-weight: 900; color: #8a8cb0; }
.gb-arrow { font-weight: 900; color: var(--pink); padding-bottom: 4rpx; }
.gb-new em { font-style: normal; font-family: var(--chunky); font-size: 44rpx; color: var(--pink); display: inline-block; }
/* The result screens grew (growth, quests): keep the next actions on screen (id038). */
.result-card .actions { position: sticky; bottom: -40rpx; z-index: 2; flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 16rpx; margin: 20rpx -40rpx -40rpx; padding: 28rpx 32rpx calc(28rpx + 0rpx); border-top: 5rpx dashed #c9cbe8; border-radius: 0 0 50rpx 50rpx; background: #fff; }
.result-card .actions .big-btn { flex: 1 0 100%; max-width: 720rpx; height: 124rpx; }
.result-card .actions .sub-btn { flex: 1 1 auto; min-width: 0; height: 92rpx; padding: 0 24rpx; font-size: 30rpx; }
.result-card .actions .sub-btn[hidden] { display: none; }

/* ------------------------------------------------------------ time capsule (id039) */
.card.capsule { background: #fffaf0; box-shadow: 0 14rpx 0 var(--ink), 0 0 0 10rpx #ffb86b; }
.capsule-intro { position: absolute; width: 0; height: 0; }
.ci-env { position: absolute; left: 0; top: 0; width: 460rpx; transform: translate(-50%, -50%); opacity: 0; filter: drop-shadow(0 12rpx 0 rgba(27, 29, 77, .85)); }
.ci-env svg { width: 100%; display: block; overflow: visible; }
.env-flap { transform-origin: 220rpx 80rpx; transform-box: view-box; }
.ci-letter { position: absolute; left: 50%; top: 50%; width: 380rpx; padding: 20rpx 16rpx 24rpx; border: 6rpx solid var(--ink); border-radius: 24rpx; background: #fff; text-align: center; transform: translate(-50%, -50%) scale(.8); opacity: 0; z-index: 1; }
.ci-letter small { display: block; font-size: 22rpx; font-weight: 900; color: #e08a2a; letter-spacing: .1em; }
.ci-letter b { display: block; font-family: var(--chunky); font-weight: 400; font-size: 40rpx; }
.ci-letter span { display: block; font-size: 22rpx; font-weight: 900; opacity: .7; }
.capsule-result { position: absolute; display: flex; flex-direction: column; align-items: center; padding: 16rpx 32rpx 20rpx; border: 6rpx solid var(--ink); border-radius: 36rpx; background: #fffaf0; box-shadow: 0 10rpx 0 var(--ink), 0 0 0 8rpx #ffb86b; transform: translate(-50%, 0); opacity: 0; white-space: nowrap; }
.capsule-result small { font-size: 22rpx; font-weight: 900; color: #e08a2a; letter-spacing: .1em; }
.capsule-result b { font-family: var(--chunky); font-weight: 400; font-size: 40rpx; }
.capsule-result > span { font-size: 26rpx; font-weight: 900; }
.cr-row { display: flex; align-items: flex-end; gap: 20rpx; }
.cr-old, .cr-new { display: flex; flex-direction: column; align-items: center; line-height: 1.1; }
.cr-old i, .cr-new i { font-style: normal; font-size: 20rpx; font-weight: 900; opacity: .6; }
.cr-old { font-size: 32rpx; font-weight: 900; color: #8a8cb0; }
.cr-new { font-family: var(--chunky); font-size: 52rpx; color: var(--pink); }
.cr-arrow { font-weight: 900; color: #e08a2a; padding-bottom: 8rpx; }
.skill-news p.capsule-news { background: #fffaf0; box-shadow: inset 0 0 0 4rpx #ffb86b; }
.skill-news p.capsule-news b { margin-right: 16rpx; color: #e08a2a; }
.cr-new i, .gb-new small { font-family: var(--round); line-height: 1.3; margin-bottom: 2rpx; }
.cr-new, .gb-new em { line-height: 1; }
/* id050: review sits right under じぶんレベル. */
.modes > .review-main { min-width: 480rpx; font-weight: 900; }
.modes > .review-main[hidden] { display: none; }

/* ------------------------------------------------------------ rust (id040) */
.node.rusty { background: linear-gradient(160deg, #fff1cc, #e7c88a); }
.node.rusty::before { content: ""; position: absolute; inset: 6rpx; border-radius: 22rpx; pointer-events: none;
  background: radial-gradient(circle at 18% 26%, rgba(168, 98, 40, .45) 0 6rpx, transparent 7rpx), radial-gradient(circle at 78% 72%, rgba(168, 98, 40, .4) 0 8rpx, transparent 9rpx), radial-gradient(circle at 64% 20%, rgba(168, 98, 40, .35) 0 4rpx, transparent 5rpx), radial-gradient(circle at 30% 80%, rgba(168, 98, 40, .3) 0 5rpx, transparent 6rpx); }
.node .rust { position: absolute; top: -18rpx; left: -12rpx; padding: 0 8rpx; border: 3rpx solid var(--ink); border-radius: 12rpx; background: #c9772f; color: #fff; font-style: normal; font-size: 18rpx; line-height: 28rpx; transform: rotate(-10deg); }
.skill-news p.polish-news { background: linear-gradient(90deg, #fff, #fff6c8, #fff); }

/* ------------------------------------------------------------ collection (id041) */
#screen-collect { flex-direction: column; padding: calc(20rpx + 0rpx) 0 0; }
.co-preview { position: relative; flex: none; height: min(28vh, 440rpx); margin: 0 28rpx 16rpx; border: 6rpx solid var(--ink); border-radius: 44rpx; background: rgba(255, 255, 255, .35); box-shadow: 0 10rpx 0 var(--ink); overflow: hidden; }
.co-preview .co-mark { left: 50%; top: 50%; right: auto !important; transform-origin: center; translate: -50% -58%; }
.co-now { position: absolute; left: 20rpx; top: 16rpx; margin: 0; padding: 4rpx 20rpx; border-radius: 1998rpx; background: var(--ink); color: #fff; font-size: 22rpx; font-weight: 900; }
.co-tabs { flex: none; display: flex; gap: 12rpx; overflow-x: auto; padding: 4rpx 28rpx 16rpx;  }
.co-tabs
.co-tabs button { flex: none; display: flex; flex-direction: column; align-items: center; padding: 8rpx 24rpx; border: 5rpx solid var(--ink); border-radius: 28rpx; background: #fff; font-size: 24rpx; font-weight: 900; line-height: 1.2; }
.co-tabs button small { font-size: 20rpx; opacity: .6; }
.co-tabs button[aria-pressed="true"] { background: var(--yellow); box-shadow: 0 6rpx 0 var(--ink); }
.co-scroll { flex: 1; overflow: auto;  padding: 0 28rpx calc(80rpx + 0rpx); }
.co-note { margin: 0 0 16rpx; font-size: 24rpx; font-weight: 900; opacity: .7; text-align: center; }
.co-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.co-item { display: flex; flex-direction: column; align-items: center; gap: 6rpx; min-width: 0; padding: 16rpx 8rpx 16rpx; border: 5rpx solid var(--ink); border-radius: 32rpx; background: #fff; box-shadow: 0 6rpx 0 var(--ink); }
.co-item.on { background: #fff4c4; box-shadow: 0 0 0 8rpx var(--pink), 0 6rpx 0 var(--ink); }
.co-item.locked { background: #eceaf3; color: #8a8cb0; border-color: #a9abc9; box-shadow: 0 6rpx 0 #a9abc9; }
.co-item.locked .co-th { filter: grayscale(1) brightness(.6) contrast(.6); opacity: .45; }
.co-th { display: grid; place-items: center; width: 128rpx; height: 128rpx; }
.co-th > svg, .co-th .th-crowd svg { width: 100%; height: 100%; display: block; }
.co-th b { font-family: var(--chunky); font-weight: 400; font-size: 68rpx; color: var(--pink); }
.co-item.auto .co-th { border: 5rpx dashed var(--ink); border-radius: 50%; width: 112rpx; height: 112rpx; margin: 8rpx; }
.th-bg { display: block; width: 116rpx; height: 116rpx; border: 5rpx solid var(--ink); border-radius: 28rpx; }
.th-music { display: grid; place-items: center; width: 116rpx; height: 116rpx; border: 5rpx solid var(--ink); border-radius: 50%; background: #fff; }
.th-music svg { width: 80rpx; height: 80rpx; }
.th-crowd { display: flex; width: 140rpx; height: 128rpx; align-items: flex-end; }
.th-crowd svg { width: 34% !important; height: auto !important; margin: 0 -2%; }
.co-name { font-size: 25rpx; font-weight: 900; word-break: keep-all; overflow-wrap: anywhere; text-align: center; line-height: 1.25; }
.co-item small { font-size: 19rpx; opacity: .75; text-align: center; line-height: 1.25; word-break: keep-all; overflow-wrap: anywhere; }
.tg-list li.reward { background: linear-gradient(120deg, #fff4c4, #ffe3ef); border-style: dashed; }
.tg-list li.reward i { display: grid; place-items: center; overflow: hidden; }
.tg-list li.reward i > * { max-width: 88rpx; max-height: 88rpx; }
.tg-list li.reward .th-bg, .tg-list li.reward .th-music { width: 80rpx; height: 80rpx; }
.tr-series li small.rw { color: #d97a00; opacity: 1; }
.finale-rocket { position: absolute; left: 0; top: 0; width: 360rpx; height: 240rpx; transform-origin: 180rpx 120rpx; filter: drop-shadow(0 12rpx 0 rgba(27, 29, 77, .8)); }
.finale-rocket svg { width: 100%; height: 100%; }
.finale-banner { position: absolute; left: 0; top: 0; width: 360rpx; padding: 16rpx 0; border: 8rpx solid var(--ink); border-radius: 24rpx; background: #fff; color: var(--pink); font-family: var(--chunky); font-size: 60rpx; text-align: center; box-shadow: 0 12rpx 0 var(--ink); }
/* id045: "もうすぐ" — the closest next steps. */
.tr-soon { display: grid; grid-template-columns: 80rpx 1fr 112rpx; align-items: center; gap: 20rpx; margin-bottom: 16rpx; padding: 14rpx 20rpx 14rpx 14rpx; border: 5rpx solid var(--ink); border-radius: 32rpx; background: #fff; box-shadow: 0 6rpx 0 var(--ink); }
.tr-pct { display: grid; place-items: center; width: 104rpx; height: 104rpx; border-radius: 50%; background: conic-gradient(var(--pink) calc(var(--p) * 360deg), #eceaf3 0); }
.tr-pct b { display: grid; place-items: center; width: 80rpx; height: 80rpx; border-radius: 50%; background: #fff; font-family: var(--chunky); font-weight: 400; font-size: 24rpx; }
.tr-filter { flex-wrap: wrap; }

/* ------------------------------------------------------------ title guide (id052) */
.help-btn { top: calc(144rpx + 0rpx); }
#guide { position: fixed; inset: 0; z-index: 10; touch-action: none; }
#guide[hidden] { display: none; }
.guide-shade, #guide-actor { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
#guide-actor { overflow: visible; }
#guide-skip { position: absolute; top: calc(24rpx + 0rpx); right: 32rpx; min-width: 180rpx; min-height: 88rpx; background: var(--paper); }
#guide-card { position: absolute; left: 50%; transform: translateX(-50%); width: min(720rpx, calc(100% - 64rpx)); padding: 32rpx; border: 6rpx solid var(--ink); border-radius: 44rpx 36rpx 48rpx 32rpx; box-shadow: 0 12rpx 0 var(--ink); background: var(--paper); text-align: center; }
#guide-heading { margin: 0 0 16rpx; font-size: 40rpx; line-height: 1.4; }
#guide-text { margin: 0; white-space: pre-line; font-size: 30rpx; line-height: 1.7; }
#guide-dots { display: flex; justify-content: center; gap: 18rpx; margin: 28rpx 0; }
#guide-dots i { width: 20rpx; height: 20rpx; border: 4rpx solid var(--ink); border-radius: 50%; background: #fff; }
#guide-dots .current { background: var(--pink); transform: scale(1.25); }
.guide-actions { display: flex; gap: 24rpx; }
.guide-actions button { flex: 1; min-width: 0; height: 96rpx; font-size: 36rpx; padding: 0 16rpx; }
#guide-back:disabled { opacity: .4;  }
#guide-recommend { position: absolute; padding: 4rpx 16rpx; border: 4rpx solid var(--ink); border-radius: 12rpx; background: var(--yellow); font-size: 26rpx; font-weight: 900; transform: rotate(-4deg); }
page.guide-open .logo *, page.guide-open .logo-burst { animation: none !important; }
@media (max-height:1360rpx) {
  #guide-card { padding: 24rpx; }
  #guide-heading { font-size: 36rpx; }
  #guide-text { font-size: 28rpx; }
  #guide-dots { margin: 24rpx 0; }
}
/* Keep the real help button clear of Skip when both targets fit. */
#guide.guide-last #guide-skip { left: 32rpx; right: auto; }
#guide-help-ring { animation: guide-help-pulse 1.4s ease-in-out infinite; }
.guide-help-icon { position: relative; display: inline-grid; place-items: center; vertical-align: middle; width: 64rpx; height: 64rpx; padding: 6rpx; margin: 8rpx 6rpx; background: #fff; box-shadow: 0 6rpx 0 var(--ink);  }
.guide-help-icon svg { display: block; width: 100%; height: 100%; }
.guide-help-fallback::after { content: ''; position: absolute; inset: -10rpx; border: 4rpx solid var(--yellow); border-radius: 28rpx; animation: guide-help-pulse 1.4s ease-in-out infinite; }
@keyframes guide-help-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
page.reduced #guide-help-ring, page.reduced .guide-help-fallback::after { animation: none; }
