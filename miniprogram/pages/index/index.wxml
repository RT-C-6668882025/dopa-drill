<view class="paper"></view>
<view class="app">
 <scroll-view wx:if="{{screen==='title'}}" scroll-y class="screen title">
  <view class="corner"><button class="icon-btn help" bindtap="openGuide">?</button><button class="icon-btn" bindtap="openSettings">⚙</button></view>
  <view class="logo"><view class="logo-top"><text>多</text><text>帕</text></view><view class="logo-ribbon">速 算</view><view class="logo-bits"><text>＋</text><text>×</text><text>÷</text><text>−</text></view></view>
  <view class="title-stage"><view class="mascot">◉ᴗ◉</view></view>
  <view class="modes">
   <button class="big-btn level-btn" bindtap="startLevel"><text>个性化闯关</text><text class="small">{{levelSub}}</text></button>
   <button wx:if="{{reviewCount}}" class="sub-btn review-btn" bindtap="startReview">巩固错题 {{reviewCount}}</button>
   <view class="grades"><button wx:for="{{grades}}" wx:key="*this" data-grade="{{item}}" bindtap="startGrade">{{item}}<text class="small">年级</text></button></view>
   <view class="mode-row"><button class="sub-btn" bindtap="openTree">技能树 <text>{{treeBadge}}</text></button><button class="sub-btn" bindtap="openTrophy">成就奖杯 <text>{{trophyBadge}}</text></button><button class="sub-btn" bindtap="openCollect">收藏展示 <text>{{collectBadge}}</text></button></view>
  </view>
  <view class="quest-card"><view class="quest-head"><text>今日任务</text><text>{{questReward}}</text></view><view wx:for="{{quests}}" wx:key="id" class="quest-row {{item.done?'done':''}}"><text>{{item.done?'✓':'○'}}</text><text class="quest-text">{{item.text}}</text><text>{{item.prog}}/{{item.goal}}</text></view></view>
  <view class="cal-card"><view class="cal-head"><button bindtap="prevMonth">‹</button><text>出勤打卡日历</text><button bindtap="nextMonth">›</button></view><view class="cal-month">{{calTitle}}</view><view class="cal-week"><text wx:for="{{week}}" wx:key="*this">{{item}}</text></view><view class="cal-grid"><view wx:for="{{calendar}}" wx:key="key" class="cal-day {{item.played?'played':''}} {{item.today?'today':''}}" data-day="{{item.key}}" bindtap="openDay">{{item.d||''}}<text wx:if="{{item.sticker}}" class="sticker">★</text></view></view></view>
  <text class="hint">支持使用数字键和退格键（Backspace）作答</text>
 </scroll-view>

 <view wx:elif="{{screen==='tree'}}" class="screen"><view class="tree-head"><button class="icon-btn" bindtap="goTitle">‹</button><text>技能树</text><text>{{treeCount}}</text></view><text class="tree-stars">{{treeStars}}</text><text class="tree-note">轻按练习（达到 ☆ 条件可掌握）· 长按可重置该技能及后续节点</text><scroll-view scroll-y class="tree-scroll"><view wx:for="{{tree}}" wx:key="id" class="tree-node {{item.state}}" data-id="{{item.id}}" bindtap="skillInfo" bindlongpress="askRelock"><text>{{item.grade}}年级 · {{item.lane}}</text><text class="node-name">{{item.name}}</text><text>{{item.stars}}</text></view></scroll-view></view>

 <view wx:elif="{{screen==='trophy'}}" class="screen"><view class="tree-head"><button class="icon-btn" bindtap="goTitle">‹</button><text>成就奖杯</text><text>{{trophyCount}}</text></view><view class="tr-filter"><button wx:for="{{trophyFilters}}" wx:key="id" data-f="{{item.id}}" bindtap="setTrophyFilter">{{item.name}}</button></view><scroll-view scroll-y class="tr-scroll"><view wx:for="{{trophySeries}}" wx:key="key" class="tr-series"><text class="series-title">{{item.title}}</text><view wx:for="{{item.items}}" wx:for-item="t" wx:key="id" class="tr-item {{t.got?'got':''}}"><text>{{t.got?'🏆':'○'}}</text><view><text class="node-name">{{t.name}}</text><text class="small">{{t.desc}}</text></view></view></view></scroll-view></view>

 <view wx:elif="{{screen==='collect'}}" class="screen"><view class="tree-head"><button class="icon-btn" bindtap="goTitle">‹</button><text>宝物收藏库</text><text>{{collectCount}}</text></view><view class="co-preview"><view class="mascot">◉ᴗ◉</view><text>{{collectNow}}</text></view><scroll-view scroll-y class="co-scroll"><text class="tree-note">在此选择游戏中生效的视觉外观、音乐与终场特效（选择“随机”每次将自动随机）</text><view class="co-grid"><button wx:for="{{collection}}" wx:key="id" class="co-item {{item.unlocked?'':'locked'}}" data-id="{{item.id}}" bindtap="equipItem"><text>{{item.name}}</text><text class="small">{{item.unlocked?'':'🔒'}}</text></button></view></scroll-view></view>

 <view wx:elif="{{screen==='play'}}" class="screen play"><view class="hud"><view class="pips"><text wx:for="{{pips}}" wx:key="i" class="{{item.done?'done':''}}">●</text></view><view class="clock"><text>{{clockLabel}}</text><text class="clock-big">{{clock}}</text></view><button class="icon-btn" bindtap="toggleMute">♪</button></view><view class="hud2"><view>正确 <b>{{ok}}</b><text>/{{N}}</text>　差一点 <b>{{ng}}</b></view><view class="combo"><b>{{combo}}</b><text>连击</text><text>{{comboMult}}</text></view><view class="dopa"><text>多帕</text><b>{{dopa}}</b></view></view><view class="stage"><view class="mascot {{mascotState}}">◉ᴗ◉</view></view><view class="card"><view class="card-top"><text class="chip">{{qtitle}}</text><text>{{qno}}</text></view><view class="sheet" style="height:{{sheetHeight}}rpx"><view wx:if="{{bracket}}" class="bracket" style="{{bracket.style}}"></view><view wx:for="{{cells}}" wx:key="key" class="cell {{item.kind||''}} {{item.active?'active':''}}" style="{{item.style}}">{{item.text}}</view><view wx:for="{{lines}}" wx:key="key" class="line" style="{{item.style}}"></view></view><text class="step-label">{{stepLabel}}</text><view class="stamp">{{stamp}}</view></view><view class="pad"><button wx:for="{{keys}}" wx:key="*this" data-key="{{item}}" bindtap="keyTap">{{item}}</button><button data-key="Backspace" bindtap="keyTap">⌫</button></view></view>

 <view wx:elif="{{screen==='result'||screen==='final'}}" class="screen result"><view class="result-card"><text class="chip">{{resultTitle}}</text><view class="score"><b>{{score}}</b><text>分</text></view><view class="stats"><view><text>正确</text><b>{{resultOk}}题</b></view><view><text>差一点</text><b>{{resultNg}}次</b></view><view><text>初次正解率</text><b>{{resultRate}}%</b></view><view><text>用时</text><b>{{resultTime}}</b></view></view><view class="dopa-final"><text>多帕</text><b>{{dopa}}</b></view><view class="actions"><button wx:if="{{screen==='result'}}" class="big-btn" bindtap="startExtra">挑战加时赛<text class="small">90秒限时</text></button><button class="sub-btn" bindtap="goTitle">结束返回</button></view></view></view>
</view>

<view wx:if="{{modal}}" class="modal"><view class="modal-card">
 <block wx:if="{{modal==='settings'}}"><text class="chip">系统设置</text><text class="set-label">语言 / Language</text><view class="pick"><button data-lang="zh" bindtap="setLang">中文</button><button data-lang="ja" bindtap="setLang">日本語</button><button data-lang="en" bindtap="setLang">English</button></view><text class="set-label">每组题数</text><view class="pick"><button wx:for="{{counts}}" wx:key="*this" data-count="{{item}}" bindtap="setCount">{{item}}题</button></view><text class="set-label">音效与音乐</text><switch checked="{{settings.sound}}" bindchange="setSound"/><slider value="{{volume}}" min="0" max="100" bindchange="setVolume"/><text class="set-label">动态特效强度 {{motion}}%</text><slider value="{{motion}}" min="0" max="100" bindchange="setMotion"/><button class="sub-btn danger" bindtap="resetData">全部重置</button><button class="big-btn" bindtap="closeModal">关闭</button></block>
 <block wx:elif="{{modal==='skill'}}"><text class="chip">{{skillModal.grade}}年级</text><text class="modal-title">{{skillModal.name}}</text><text>{{skillModal.stars}}</text><text>{{skillModal.next}}</text><view class="confirm-actions"><button class="sub-btn" bindtap="closeModal">关闭</button><button class="sub-btn" bindtap="practiceSkill">专项练习</button></view></block>
 <block wx:elif="{{modal==='confirm'}}"><text class="chip">重置此技能进度</text><text>确定要清除该技能及其所有后续依赖技能的练习记录吗？</text><view class="confirm-actions"><button class="sub-btn" bindtap="closeModal">取消</button><button class="sub-btn danger" bindtap="confirmRelock">确认重置</button></view></block>
 <block wx:elif="{{modal==='bonus'}}"><text class="chip">每日登录奖励</text><text>{{bonusText}}</text><view class="bonus-grid"><text wx:for="{{bonusSlots}}" wx:key="i">{{item}}</text></view><button class="big-btn" bindtap="closeModal">立即领取</button></block>
 <block wx:elif="{{modal==='day'}}"><text class="chip">{{dayTitle}}</text><view wx:for="{{dayRecords}}" wx:key="id"><text>{{item.mode}} · {{item.score}}分</text></view><button class="big-btn" bindtap="closeModal">关闭</button></block>
</view></view>