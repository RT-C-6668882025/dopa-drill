<view class="paper"></view>
<view class="app">
<scroll-view wx:if="{{screen==='home'}}" class="screen title-screen" scroll-y>
  <view class="top-icons"><button class="icon-btn" bindtap="openSettings">⚙</button></view>
  <view class="logo">
    <view class="logo-burst"></view>
    <view class="logo-top"><text class="logo-char c1">多</text><text class="logo-char c2">帕</text></view>
    <view class="logo-ribbon"><text>速 算</text></view>
    <text class="logo-bit b1">＋</text><text class="logo-bit b2">×</text><text class="logo-bit b3">÷</text><text class="logo-bit b4">−</text>
  </view>
  <view class="title-stage"><view class="dk idle"><view class="ear el"></view><view class="ear er"></view><view class="dk-head"><view class="face"><view class="eye le"></view><view class="eye re"></view><view class="mouth"></view></view></view><view class="dk-body"></view><view class="foot fl"></view><view class="foot fr"></view></view></view>
  <view class="modes">
    <button class="big-btn level-btn" bindtap="openTree"><text>个性化闯关</text><text class="btn-sub">从技能树选择当前训练</text></button>
    <view class="grades">
      <button wx:for="{{grades}}" wx:key="*this" data-grade="{{item}}" bindtap="quickGrade">{{item}}<text>年级</text></button>
    </view>
    <view class="mode-row"><button class="sub-btn" bindtap="openTree">技能树</button><button class="sub-btn" bindtap="openTrophies">成就奖杯</button><button class="sub-btn" bindtap="openCollection">收藏展示</button></view>
  </view>
  <view class="quest-card"><view class="quest-head"><text>今日任务</text><text>连续 {{streak}} 天</text></view><view wx:for="{{questItems}}" wx:key="id" class="quest-row {{item.done?'done':''}}"><text class="qchk">{{item.done?'✓':''}}</text><text>{{item.text}}</text><text>{{item.cur}}/{{item.goal}}</text></view></view>
</scroll-view>

<view wx:elif="{{screen==='tree'}}" class="screen tree-screen">
  <view class="tree-head"><button class="icon-btn" bindtap="goTitle">‹</button><text>技能树</text><text class="tree-count">{{mastered}} / 58</text></view>
  <scroll-view class="tree-scroll" scroll-y><view wx:for="{{tree}}" wx:key="grade" class="grade-block"><text class="grade-title">{{item.grade}} 年级</text><view class="nodes"><button wx:for="{{item.items}}" wx:for-item="s" wx:key="id" class="node {{s.locked?'locked':s.mastered?'mastered':s.learning?'learning':'new'}}" disabled="{{s.locked}}" data-id="{{s.id}}" bindtap="startSkill"><text>{{s.name}}</text><text class="stars">{{s.starsText}}</text><view class="ring"><view style="width:{{s.mastery*100}}%"></view></view></button></view></view></scroll-view>
</view>

<view wx:elif="{{screen==='play'}}" class="screen play-screen">
  <view class="hud"><view class="pips"><view wx:for="{{pips}}" wx:key="i" class="pip {{item.done?'done':''}} {{item.now?'now':''}}"></view></view><view class="clock {{clockLabel==='剩余'?'extra':''}}"><text>{{clockLabel}}</text><text>{{clock}}</text></view><button class="icon-btn">♪</button></view>
  <view class="hud2"><view class="tally"><text>正确 <text class="b">{{ok}}</text><text class="small" wx:if="{{N}}">/{{N}}</text></text><text class="ng">差一点 <text class="b">{{ng}}</text></text></view><view wx:if="{{combo>1}}" class="combo"><text class="b">{{combo}}</text><text class="small">连击</text></view><view class="dopa"><text class="small">多帕</text><text class="b">{{dopa}}</text></view></view>
  <view class="stage"><view class="bunting">◆　◆　◆　◆　◆</view><view class="spot sl"></view><view class="spot sr"></view><view class="dk {{actorState}}"><view class="ear el"></view><view class="ear er"></view><view class="dk-head"><view class="face"><view class="eye le"></view><view class="eye re"></view><view class="mouth"></view></view></view><view class="dk-body"></view><view class="arm al"></view><view class="arm ar"></view><view class="foot fl"></view><view class="foot fr"></view></view><view class="ground"></view></view>
  <view class="card {{celebrate?'celebrate':''}}"><view class="marquee"></view><view class="card-top"><text class="chip">{{problemTitle}}</text><text class="qno">{{qno}}</text></view><view class="sheet-wrap"><view class="sheet" style="height:{{sheetHeight}}rpx"><view wx:if="{{bracket}}" class="bracket" style="{{bracket.style}}"></view><view wx:for="{{cells}}" wx:key="key" class="cell {{item.kind}} {{item.active?'active':''}} {{item.hidden?'hidden':''}}" style="{{item.style}}">{{item.text}}</view><view wx:for="{{lines}}" wx:key="key" class="hline {{item.hidden?'hidden':''}}" style="{{item.style}}"></view></view></view><view class="step-label">{{stepLabel}}</view><view wx:if="{{celebrate}}" class="stamp">◎</view></view>
  <view class="pad"><button wx:for="{{keys}}" wx:key="*this" class="{{item==='⌫'?'del':item==='0'?'zero':''}}" data-key="{{item}}" bindtap="tapKey">{{item}}</button></view>
</view>

<scroll-view wx:elif="{{screen==='result'||screen==='final'}}" class="screen result-screen" scroll-y>
 <view class="result-card"><text class="chip">{{resultTitle}}</text><view class="score"><text class="b">{{score}}</text><text>分</text></view><view wx:if="{{screen==='final'}}" class="breakdown">基础 100 ＋ 挑战加分 {{score-100}}</view><view class="stats"><view><text class="small">正确</text><text class="b">{{resultOk}}题</text></view><view><text class="small">差一点</text><text class="b">{{resultNg}}次</text></view><view><text class="small">{{screen==='final'?'挑战正解率':'初次正解率'}}</text><text class="b">{{resultRate}}%</text></view><view><text class="small">用时</text><text class="b">{{resultTime}}</text></view></view><view class="dopa-final"><text class="small">多帕</text><text class="b">{{dopa}}</text></view><view class="actions"><button wx:if="{{screen==='result'&&extraUnlocked}}" class="big-btn" bindtap="startExtra">挑战加时赛 <text class="small">90秒限时</text></button><button class="sub-btn" bindtap="goTitle">结束返回</button></view></view>
</scroll-view>

<view wx:elif="{{screen==='quests'}}" class="screen simple-screen"><view class="tree-head"><button class="icon-btn" bindtap="goTitle">‹</button><text>今日任务</text></view><view class="panel"><view wx:for="{{questItems}}" wx:key="id" class="quest-row"><text>{{item.text}}</text><text>{{item.cur}}/{{item.goal}}</text></view></view></view>
<view wx:elif="{{screen==='collection'}}" class="screen simple-screen"><view class="tree-head"><button class="icon-btn" bindtap="goTitle">‹</button><text>宝物收藏库</text><text>{{collectionCount}} / 47</text></view><scroll-view class="simple-scroll" scroll-y><view class="collect-grid"><view wx:for="{{collectionItems}}" wx:key="id" class="collect-item {{item.unlocked?'':'locked'}}"><text>{{item.unlocked?'★':'?'}}</text><text class="b">{{item.name}}</text><text class="small">{{item.cat}}</text></view></view></scroll-view></view>
<view wx:elif="{{screen==='trophies'}}" class="screen simple-screen"><view class="tree-head"><button class="icon-btn" bindtap="goTitle">‹</button><text>成就奖杯</text><text>{{trophyCount}}</text></view><scroll-view class="simple-scroll" scroll-y><view class="collect-grid"><view wx:for="{{trophyItems}}" wx:key="id" class="collect-item {{item.got?'':'locked'}}"><text>🏆</text><text class="b">{{item.name}}</text><text class="small">{{item.got?'已获得':'未获得'}}</text></view></view></scroll-view></view>
<view wx:elif="{{screen==='settings'}}" class="screen settings-screen"><view class="panel settings"><text class="chip">系统设置</text><view class="set-row"><text>每组题数</text><view class="pick"><button wx:for="{{counts}}" wx:key="*this" class="{{settings.count===item?'on':''}}" data-n="{{item}}" bindtap="setCount">{{item}}题</button></view></view><view class="set-row"><text>音效与音乐</text><switch checked="{{settings.sound}}" data-k="sound" bindchange="toggleSetting"/></view><view class="set-row"><text>震动反馈</text><switch checked="{{settings.vibration}}" data-k="vibration" bindchange="toggleSetting"/></view><button class="sub-btn danger" bindtap="resetData">全部重置</button><button class="big-btn" bindtap="goTitle">关闭</button></view></view>
</view>